<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme for API 24 -->
    <style name="Base.Theme.MachineNote" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/action_primary</item>
        <item name="colorPrimaryDark">@color/blue_600</item>
        <item name="colorAccent">@color/action_secondary</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/action_primary</item>

        <!-- Typography -->
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:textColor">@color/content_primary</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/background_app</item>
    </style>

    <!-- ===== BASE BUTTON STYLES h ===== -->

    <!-- Base button style with common properties -->
    <style name="BaseButton" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">@null</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:textSize">@dimen/button_text_size</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:paddingLeft">@dimen/button_padding_horizontal</item>
        <item name="android:paddingRight">@dimen/button_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Base outlined button style -->
    <style name="BaseOutlinedButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:textSize">@dimen/button_text_size</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:paddingLeft">@dimen/button_padding_horizontal</item>
        <item name="android:paddingRight">@dimen/button_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ===== BUTTON VARIANTS ===== -->

    <!-- Primary Button -->
    <style name="Button.Primary" parent="BaseButton">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/content_inverse</item>
        <item name="android:elevation">@dimen/button_elevation</item>
    </style>


    <!-- Secondary Button -->
    <style name="Button.Secondary" parent="BaseButton">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/content_inverse</item>
        <item name="android:elevation">@dimen/button_elevation</item>
    </style>

    <!-- Success Button -->
    <style name="Button.Success" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_button_success</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/content_inverse</item>
        <item name="android:elevation">@dimen/button_elevation</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:textSize">@dimen/button_text_size</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:paddingLeft">@dimen/button_padding_horizontal</item>
        <item name="android:paddingRight">@dimen/button_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Destructive/Cancel Button -->
    <style name="Button.Destructive" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/action_destructive</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:textSize">@dimen/button_text_size</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Icon Button -->
    <style name="Button.Icon" parent="BaseButton">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:tint">@color/content_inverse</item>
        <item name="android:elevation">@dimen/icon_button_elevation</item>
        <item name="android:minWidth">@dimen/icon_button_min_size</item>
        <item name="android:minHeight">@dimen/icon_button_min_size</item>
        <item name="android:paddingLeft">@dimen/icon_button_padding</item>
        <item name="android:paddingRight">@dimen/icon_button_padding</item>
        <item name="android:paddingTop">@dimen/icon_button_padding</item>
        <item name="android:paddingBottom">@dimen/icon_button_padding</item>
    </style>

    <!-- Large Camera Button -->
    <style name="Button.Camera.Large" parent="BaseButton">
        <item name="android:background">@drawable/bg_button_success</item>
        <item name="android:textColor">@color/content_inverse</item>
        <item name="android:tint">@color/content_inverse</item>
        <item name="android:elevation">@dimen/camera_button_elevation</item>
        <item name="android:minHeight">@dimen/camera_button_min_height</item>
        <item name="android:paddingTop">@dimen/camera_button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/camera_button_padding_vertical</item>
    </style>

    <!-- Tab Button -->
    <style name="Button.Tab" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textSize">@dimen/tab_button_text_size</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:backgroundTint">@drawable/bg_toggle_button</item>
        <item name="android:minHeight">@dimen/tab_button_min_height</item>
        <item name="android:paddingLeft">@dimen/tab_button_padding_horizontal</item>
        <item name="android:paddingRight">@dimen/tab_button_padding_horizontal</item>
    </style>

    <!-- Toggle Button -->
    <style name="Button.Toggle" parent="BaseOutlinedButton">
        <item name="android:background">@drawable/bg_toggle_button</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:minHeight">@dimen/toggle_button_min_height</item>
    </style>

    <!-- ===== INPUT STYLES ===== -->

    <!-- Base input style -->
    <style name="Input.Base" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textSize">@dimen/input_text_size</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">@dimen/input_padding</item>
        <item name="android:paddingRight">@dimen/input_padding</item>
        <item name="android:paddingTop">@dimen/input_padding</item>
        <item name="android:paddingBottom">@dimen/input_padding</item>
        <item name="android:layout_marginBottom">@dimen/input_margin_bottom</item>
        <item name="android:minHeight">@dimen/input_min_height</item>
    </style>

    <!-- Custom Dialog Theme -->
    <style name="Dialog.Custom" parent="Theme.AppCompat.Dialog">
        <item name="colorAccent">@color/surface_primary</item>
        <item name="android:windowBackground">@drawable/bg_card_primary</item>
        <item name="android:textColorAlertDialogListItem">@color/content_primary</item>
    </style>

    <!-- ===== LEGACY COMPATIBILITY ===== -->

    <!-- Legacy style names for backward compatibility -->
    <style name="primaryButton" parent="Button.Primary" />
    <style name="secondaryButton" parent="Button.Secondary" />
    <style name="confirmButton" parent="Button.Success" />
    <style name="cancelButton" parent="Button.Destructive" />
    <style name="iconButton" parent="Button.Icon" />
    <style name="largeCameraButton" parent="Button.Camera.Large" />
    <style name="tabButton" parent="Button.Tab" />
    <style name="materialButtonToggle" parent="Button.Toggle" />
    <style name="CustomDialogTheme" parent="Dialog.Custom" />


    <!-- SearchView Theme -->
    <style name="SearchViewTheme" parent="Widget.AppCompat.SearchView">
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:textColorHint">@color/content_tertiary</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
    </style>

    <!-- Add this to your styles.xml -->
    <style name="Button.MaterialTab" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">@dimen/tab_button_text_size</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:minHeight">@dimen/tab_button_min_height</item>
        <item name="android:paddingLeft">@dimen/tab_button_padding_horizontal</item>
        <item name="android:paddingRight">@dimen/tab_button_padding_horizontal</item>
        <item name="strokeColor">@color/action_primary</item>
        <item name="strokeWidth">1dp</item>
    </style>

</resources>