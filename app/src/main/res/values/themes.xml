<resources>

    <!-- Base application theme -->
    <style name="Base.Theme.MachineNote" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color - changed to proper primary color -->
        <item name="colorPrimary">@color/blue_300</item>
        <item name="colorPrimaryVariant">@color/blue_250</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondaryAccentColor</item>
        <item name="colorSecondaryVariant">@color/secondaryAccentDark</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/backgroundColorOfApp</item>

        <!-- Fonts & background -->
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:windowBackground">@color/backgroundColorOfApp</item>
    </style>

    <!-- TextView with rounded background -->
    <style name="textViewTheme">
        <item name="android:background">@drawable/bg_rounded_card</item>
    </style>

    <!-- Base Material Button -->
    <style name="materialButton" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/primary_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:textSize">20sp</item>
        <item name="elevation">0dp</item>
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Primary Button -->
    <style name="primaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@drawable/primary_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Secondary Outlined Button -->
    <style name="secondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:backgroundTint">@color/inputFieldBackground</item>
        <item name="android:textColor">@color/textPrimaryColor</item>
        <item name="strokeColor">@color/gray_30</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Icon Button - FIXED with explicit backgroundTint -->
    <style name="iconButton" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@drawable/bg_icon</item>
        <item name="backgroundTint">@null</item>
        <item name="android:tint">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:elevation">2dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Large Camera Button -->
    <style name="largeCameraButton" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/sendButtonColor</item>
        <item name="backgroundTint">@color/sendButtonColor</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:tint">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:elevation">6dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Cancel Button -->
    <style name="cancelButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:backgroundTint">@color/transparent</item>
        <item name="android:textColor">@color/cancelButtonTextColor</item>
        <item name="strokeColor">@color/cancelButtonStrokeColor</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Confirm Button -->
    <style name="confirmButton" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/sendButtonColor</item>
        <item name="backgroundTint">@color/sendButtonColor</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Tab Button -->
    <style name="tabButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@drawable/toggle_button_text</item>
        <item name="android:backgroundTint">@drawable/toggle_button_background</item>
        <item name="cornerRadius">0dp</item>
    </style>

    <!-- Material Toggle Button -->
    <style name="materialButtonToggle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="iconPadding">0dp</item>
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:backgroundTint">@drawable/togglebtn_25</item>
        <item name="android:layout_weight">0.5</item>
    </style>

    <!-- Custom Dialog Theme -->
    <style name="CustomDialogTheme" parent="Theme.MaterialComponents.Dialog">
        <item name="colorAccent">@color/headerBackgroundColor</item>
        <item name="android:windowBackground">@drawable/customborder_25</item>
        <item name="android:textColorAlertDialogListItem">@color/black</item>
    </style>

    <!-- Fallback Dialog Theme - FIXED -->
    <style name="DialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/primaryButtonPressed</item>
        <item name="colorControlActivated">@color/blue_300</item>
    </style>

</resources>