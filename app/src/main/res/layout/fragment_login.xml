<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    tools:context=".fragments.LoginFragment">

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Login Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_secondary"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Username Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_primary"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@mipmap/person"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/username" />

                <EditText
                    android:id="@+id/username"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/username"
                    android:textColor="@color/content_primary"
                    android:textColorHint="@color/content_tertiary"
                    android:textSize="16sp"
                    android:fontFamily="@font/nunito_semibold"
                    android:inputType="textPersonName"
                    android:importantForAutofill="no"
                    android:minHeight="48dp"
                    android:gravity="center_vertical" />

            </LinearLayout>

            <!-- Password Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_primary"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@mipmap/lock"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/password" />

                <EditText
                    android:id="@+id/password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/password"
                    android:textColor="@color/content_primary"
                    android:textColorHint="@color/content_tertiary"
                    android:textSize="16sp"
                    android:fontFamily="@font/nunito_semibold"
                    android:inputType="textPassword"
                    android:importantForAutofill="no"
                    android:minHeight="48dp"
                    android:gravity="center_vertical" />

                <ImageButton
                    android:id="@+id/togglePasswordVisibility"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@mipmap/visibility_off"
                    android:padding="12dp" />

            </LinearLayout>

            <!-- Login Button -->
            <Button
                android:id="@+id/loginBtn"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/Login"
                android:minHeight="56dp" />

        </LinearLayout>

        <!-- Registration Info -->
        <TextView
            android:id="@+id/signupText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/register_help_info"
            android:textColor="@color/content_tertiary"
            android:textSize="14sp"
            android:fontFamily="@font/nunito_semibold"
            android:textAlignment="center"
            android:gravity="center"
            android:padding="16dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</FrameLayout>