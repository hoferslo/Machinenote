<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    tools:context=".fragments.NarocilaFragment">

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Search Section -->
        <!-- Search Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_weight="1"
                android:paddingRight="8dp">

                <SearchView
                    android:id="@+id/idOfDuty"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="@string/isci_narocila"
                    android:background="@drawable/bg_input"
                    android:iconifiedByDefault="false"
                    android:queryHint="@string/isci_narocila"
                    android:theme="@style/SearchViewTheme" />
            </LinearLayout>

            <Button
                android:id="@+id/filterSortToggleBtn"
                style="@style/Button.Secondary"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:drawableEnd="@drawable/ic_filter"
                android:drawablePadding="8dp"
                android:gravity="start|center_vertical"
                android:textAllCaps="false" />

        </LinearLayout>

        <!-- Content List Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card_primary"
            android:layout_marginBottom="16dp">

            <!-- List Header (Optional) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mozna_narocila"
                android:textColor="@color/content_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/nunito_semibold"
                android:padding="16dp"
                android:paddingBottom="8dp" />

            <!-- RecyclerView Container -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/scrollLv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:padding="8dp"
                android:paddingTop="0dp"
                android:clipToPadding="false"
                />

        </LinearLayout>

        <!-- Action Button -->
        <Button
            android:id="@+id/cancelBtn"
            style="@style/Button.Destructive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />

    </LinearLayout>

    <!-- Tab Navigation -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/action_primary">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_primary" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/vnos_naloge_Ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@id/tabNarocilaBtn">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabNarocilaBtn"
                style="@style/Button.MaterialTab"
                android:backgroundTint="@color/action_primary"
                android:textColor="@color/action_secondary"
                app:iconTint="@color/action_secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/narocila"
                app:icon="@drawable/assignment_icon"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabVnosNarocilaBtn"
                style="@style/Button.MaterialTab"
                android:backgroundTint="@color/action_primary"
                android:textColor="@color/action_secondary"
                app:iconTint="@color/action_secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/vnos_narocila"
                app:icon="@drawable/add_box"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>
</LinearLayout>