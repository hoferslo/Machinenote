<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_large"
    android:layout_marginBottom="@dimen/margin_bottom"
    android:background="@drawable/bg_card_primary">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/companyName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/content_primary"
            android:fontFamily="@font/nunito_semibold"
            android:text="Company Name"
            android:padding="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/margin_bottom"
            android:background="@drawable/bg_card_secondary" />

        <TextView
            android:id="@+id/nameOfShipper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/content_secondary"
            android:fontFamily="@font/nunito_semibold"
            android:text="Contact Person"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/gmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/content_secondary"
            android:fontFamily="@font/nunito_semibold"
            android:text="Email"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/telephoneNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/content_secondary"
            android:fontFamily="@font/nunito_semibold"
            android:text="Phone Number"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/GSM"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/content_secondary"
            android:fontFamily="@font/nunito_semibold"
            android:text="GSM" />
    </LinearLayout>

    <Button
        android:id="@+id/buttonAction"
        style="@style/Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lahk bi biu za editat"
        android:visibility="gone"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/margin_bottom" />
</LinearLayout>