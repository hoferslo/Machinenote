<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    tools:context=".fragments.KemikalijeAddFragment">

    <!-- Main Content Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/formContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Article Information Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_primary"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/podatki_o_kemikaliji"
                    android:textSize="16sp"
                    android:textColor="@color/content_primary"
                    android:fontFamily="@font/nunito_semibold"
                    android:layout_marginBottom="16dp" />

                <!-- Article Name -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vpisite_ime"
                    android:textSize="12sp"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/imeSLO"
                    style="@style/Input.Base"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/ime_slo_kemikalije"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:gravity="start|center_vertical"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/imeENG"
                    style="@style/Input.Base"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/ime_eng_kemikalije"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:gravity="start|center_vertical"
                    android:layout_marginBottom="16dp" />

                <!-- Quantity and Unit Row -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vpisite_kolicino_in_enoto"
                    android:textSize="12sp"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/amountOfArticle"
                        style="@style/Input.Base"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="0dp"
                        android:hint="@string/kolicina"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:gravity="center" />

                    <Spinner
                        android:id="@+id/enotaSpinner"
                        style="@style/Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/enota" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vpisite_formulo_in_cas_st"
                    android:textSize="12sp"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:layout_marginBottom="4dp" />
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/formula"
                        style="@style/Input.Base"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="0dp"
                        android:hint="@string/formula"
                        android:importantForAutofill="no"
                        android:inputType="text"

                        android:gravity="center" />

                    <EditText
                        android:id="@+id/CAS"
                        style="@style/Input.Base"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="0dp"
                        android:layout_marginBottom="0dp"
                        android:hint="@string/CAS"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:gravity="center" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vpisite_omaro_in_polico"
                    android:textSize="12sp"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:layout_marginBottom="4dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <Spinner
                        android:id="@+id/omaraSpinner"
                        style="@style/Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:layout_marginEnd="12dp"
                         />
                    <Spinner
                        android:id="@+id/policaSpinner"
                        style="@style/Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/rok_izteka"
                        android:textSize="12sp"
                        android:textColor="@color/content_secondary"
                        android:fontFamily="@font/nunito_semibold"
                        android:layout_marginBottom="4dp" />

                    <Button
                        android:id="@+id/rok_izteka"
                        style="@style/Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/izberite_rok_uporabe"
                        android:drawableLeft="@drawable/calendar"
                        android:drawablePadding="8dp"
                        android:gravity="start|center_vertical"
                        />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vpisite_firmo_in_agregatno_stanje"
                    android:textSize="12sp"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/firma"
                        style="@style/Input.Base"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="0dp"
                        android:hint="@string/vpisi_firmo"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:gravity="center" />

                    <EditText
                        android:id="@+id/agregatnoStanje"
                        style="@style/Input.Base"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="0dp"
                        android:layout_marginBottom="0dp"
                        android:hint="@string/vpisi_agregatno_stanje"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:gravity="center" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_primary"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dodatni_podatki"
                    android:textSize="16sp"
                    android:textColor="@color/content_primary"
                    android:fontFamily="@font/nunito_semibold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vnesite_unichem_ident"
                    android:textSize="12sp"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/identUnichem"
                    style="@style/Input.Base"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/unichem_ident"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:gravity="top|start"
                    android:scrollbars="vertical" />

                <!-- Technical Info -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vnesite_opombe"
                    android:textSize="12sp"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/opombe"
                    style="@style/Input.Base"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:hint="@string/opombe"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:gravity="top|start"
                    android:scrollbars="vertical" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@drawable/bg_card_primary">

        <Button
            android:id="@+id/prekliciBtn"
            style="@style/Button.Destructive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.4"
            android:layout_marginEnd="8dp"
            android:text="@string/preklici" />

        <Button
            android:id="@+id/shraniBtn"
            style="@style/Button.Success"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:layout_marginStart="8dp"
            android:text="@string/shrani_narocilo" />

    </LinearLayout>
</LinearLayout>