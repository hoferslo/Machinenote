<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".activities.MainActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_nav"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/toolbar_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Title"
                    android:gravity="center"
                    android:textSize="24sp"
                    android:textColor="@color/content_primary"
                    android:fontFamily="@font/nunito_semibold"
                    android:paddingHorizontal="8dp" />
                <ImageView
                    android:id="@+id/workerUnichem"
                    android:backgroundTint="@color/content_inverse"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="2dp"
                    android:layout_gravity="end"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/worker_unichem"
                    android:contentDescription="Unichem" />

                <ImageButton
                    android:id="@+id/noWifiBtn"
                    style="@style/Button.Icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:layout_marginEnd="4dp"
                    android:src="@mipmap/signal_wifi_bad"
                    android:contentDescription="No WiFi"
                    app:tint="@color/content_inverse" />

            </com.google.android.material.appbar.MaterialToolbar>

            <androidx.drawerlayout.widget.DrawerLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/drawer_layout"
                android:fitsSystemWindows="true"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/fragment_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical" />

                <com.google.android.material.navigation.NavigationView
                    android:id="@+id/nav_view"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:background="@color/surface_secondary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_primary"
                        android:layout_margin="16dp"
                        android:padding="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/drawerUserNameTv"
                            android:text="@string/username"
                            android:gravity="center_vertical"
                            android:textSize="18sp"
                            android:textColor="@color/content_primary"
                            android:fontFamily="@font/nunito_semibold"
                            android:drawableLeft="@mipmap/person"
                            android:drawableTint="@color/content_secondary"
                            android:drawablePadding="12dp"
                            android:layout_marginBottom="12dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/border_primary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/drawerUserRoleTv"
                            android:text="Rola"
                            android:gravity="center_vertical"
                            android:textColor="@color/content_secondary"
                            android:fontFamily="@font/nunito_semibold"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/themeSwitcherBtn"
                            style="@style/primaryButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Spremeni temo"
                            android:drawableLeft="@drawable/ic_theme_switcher"
                            android:drawablePadding="12dp"
                            android:layout_margin="16dp"
                            android:gravity="center_vertical|start"
                            android:paddingLeft="20dp"
                            android:minHeight="56dp"/>

                        <Button
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/logout"
                            android:text="Logout"
                            style="@style/Button.Destructive"
                            android:drawableLeft="@mipmap/logout"
                            android:drawableTint="@color/action_destructive"
                            android:drawablePadding="12dp"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginBottom="16dp"
                            android:gravity="center_vertical|start"
                            android:paddingLeft="20dp"
                            android:minHeight="56dp" />

                    </LinearLayout>

                </com.google.android.material.navigation.NavigationView>

            </androidx.drawerlayout.widget.DrawerLayout>

        </LinearLayout>

        <!-- Loading Overlay -->
        <LinearLayout
            android:id="@+id/loadingLl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="invisible"
            android:background="@color/surface_primary"
            android:alpha="0.9"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:elevation="8dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/loadingProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:layout_gravity="center"
                app:indicatorColor="@color/action_primary"
                android:visibility="visible" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textSize="18sp"
                android:textColor="@color/content_primary"
                android:fontFamily="@font/nunito_semibold"
                android:text="Loading" />

        </LinearLayout>

    </FrameLayout>
</LinearLayout>