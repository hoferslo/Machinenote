<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    android:padding="@dimen/spacing_large"
    tools:context=".fragments.KnjizenjeFragment">

    <!-- Article Name Header - Compact -->
    <LinearLayout
        android:id="@+id/articleNameLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:padding="@dimen/spacing_large"
        android:background="@drawable/bg_card_interactive"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/article_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="@dimen/text_size_medium"
            android:fontFamily="@font/nunito_semibold"
            android:textColor="@color/content_primary"
            android:text="@string/request_for_article_scan"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Article Info Section - Better organized -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:background="@drawable/bg_card_primary"
        android:padding="@dimen/spacing_medium"
        android:orientation="horizontal">

        <!-- Info Items in Grid Layout -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Rack and Warehouse in same row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:orientation="horizontal">

                <!-- Rack Info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:padding="@dimen/spacing_medium"
                    android:background="@drawable/bg_card_secondary"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/content_secondary"
                        android:fontFamily="@font/nunito_semibold"
                        android:text="@string/rack_label"
                        android:textSize="@dimen/text_size_small"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/article_rack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textColor="@color/content_primary"
                        android:fontFamily="@font/nunito_semibold"
                        android:textSize="@dimen/text_size_xxl"
                        android:maxLines="1" />

                </LinearLayout>

                <!-- Warehouse Info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:padding="@dimen/spacing_medium"
                    android:background="@drawable/bg_card_secondary"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/content_secondary"
                        android:fontFamily="@font/nunito_semibold"
                        android:text="@string/warehouse_label"
                        android:textSize="@dimen/text_size_small"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/article_warehouse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_semibold"
                        android:maxLines="1"
                        android:textColor="@color/content_primary"
                        android:textSize="@dimen/text_size_xxl"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Article ID and Minimum Info Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Article ID Info -->
                <LinearLayout
                    android:id="@+id/articleIdLayout"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:padding="@dimen/spacing_medium"
                    android:background="@drawable/bg_card_secondary"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/articleIdLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/content_secondary"
                        android:fontFamily="@font/nunito_semibold"
                        android:text="ID"
                        android:textSize="@dimen/text_size_small"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/article_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textColor="@color/content_primary"
                        android:fontFamily="@font/nunito_semibold"
                        android:textSize="@dimen/text_size_xxl"
                        android:maxLines="1" />

                </LinearLayout>

                <!-- Article Minimum Info -->
                <LinearLayout
                    android:id="@+id/articleMinimumLl"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:padding="@dimen/spacing_medium"
                    android:background="@drawable/bg_card_secondary"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/content_secondary"
                        android:fontFamily="@font/nunito_semibold"
                        android:text="@string/article_minimum"
                        android:textSize="@dimen/text_size_small"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/articleMinimumTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textColor="@color/content_primary"
                        android:fontFamily="@font/nunito_semibold"
                        android:textSize="@dimen/text_size_xxl"
                        android:maxLines="1" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Gmail Button -->
        <ImageButton
            android:id="@+id/sendGmail"
            style="@style/Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/spacing_large"
            android:layout_gravity="center_vertical"
            android:visibility="gone"
            android:contentDescription="@string/send"
            android:src="@mipmap/mail"
            app:tint="@color/content_inverse" />

    </LinearLayout>

    <!-- Stock Display Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:background="@drawable/bg_card_primary"
        android:padding="@dimen/spacing_medium">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:textAllCaps="true"
            android:gravity="center"
            android:textSize="@dimen/text_size_xxl"
            android:fontFamily="@font/nunito_semibold"
            android:textColor="@color/content_primary"
            android:text="@string/stock_label"
            android:maxLines="1" />

        <TextView
            android:id="@+id/article_stock"
            android:fontFamily="@font/nunito_semibold"
            android:text="0"
            android:layout_width="wrap_content"
            android:minWidth="@dimen/icon_height"
            android:layout_height="@dimen/icon_height"
            android:textSize="@dimen/text_size_extra_large"
            style="@style/Button.Icon"
            android:maxLines="1"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="4dp"/>

    </LinearLayout>

    <!-- Show More Info Button - Fixed height -->
    <TextView
        android:id="@+id/allDataSv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        style="@style/Input.Base"
        android:text="Prikaži več informacij o artiklu"
        android:textColor="@color/content_secondary"
        android:fontFamily="@font/nunito_semibold"
        android:textSize="@dimen/text_size_medium"
        android:drawableEnd="@drawable/ic_chevron_right"
        android:drawableTint="@color/content_tertiary"
        android:drawablePadding="12dp"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:paddingVertical="@dimen/spacing_large"
        android:minHeight="48dp" />
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1"
        android:gravity="bottom"

        >

    <!-- QR Scanner Button - Big and prominent -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_primary"
        android:orientation="vertical"
        android:layout_marginBottom="@dimen/spacing_medium">

        <!-- Naslov/besedilo nad gumbovi -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upravljanje zaloge"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="@dimen/spacing_large"
            android:textColor="@color/action_primary" />

        <!-- Stock Control Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_large"
            android:orientation="horizontal">

            <Button
                android:id="@+id/minusBtn"
                style="@style/Button.Destructive"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_small"
                android:textSize="@dimen/text_size_large"
                android:text="-"
                android:minHeight="44dp" />

            <EditText
                android:id="@+id/stockChangeValue"
                style="@style/Input.Base"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_small"
                android:textSize="@dimen/text_size_xxl"
                android:layout_marginBottom="0dp"
                android:text="1"
                android:inputType="number"
                android:gravity="center"
                android:minHeight="44dp"
                android:maxLines="1" />



            <Button
                android:id="@+id/plusBtn"
                style="@style/Button.Success"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:textSize="@dimen/text_size_large"
                android:text="+"
                android:minHeight="44dp" />

        </LinearLayout>
    </LinearLayout>

    <!-- Input and Action Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        >

        <EditText
            android:id="@+id/idOfArticleEt"
            style="@style/Input.Base"
            android:layout_width="0dp"
            android:layout_weight="0.8"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_small"
            android:hint="@string/enter_id"
            android:inputType="number"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:maxLines="1"
            android:layout_marginBottom="0dp"/>

        <ImageButton
            android:id="@+id/getArticelDataByIdBtn"
            style="@style/Button.Icon"
            android:layout_height="@dimen/icon_height"
            android:layout_width="@dimen/icon_width"
            android:layout_weight="0.1"
            android:layout_marginEnd="@dimen/spacing_small"
            android:contentDescription="@string/photo_button"
            android:src="?attr/homeAsUpIndicator"
            android:rotation="180"
            android:layout_gravity="center_vertical"
            app:tint="@color/content_inverse" />

        <ImageButton
            android:id="@+id/scanQRBtn"
            style="@style/Button.Icon"
            android:layout_weight="0.1"
            android:layout_width="@dimen/icon_width"
            android:layout_height="@dimen/icon_height"
            android:contentDescription="@string/scan_qr_code"
            android:src="@mipmap/qr_code_scanner"
            app:tint="@color/content_inverse"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>

    <!-- Cancel Button -->
    <Button
        android:id="@+id/cancelBtn"
        style="@style/Button.Destructive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel"
        android:minHeight="44dp" />
    </LinearLayout>

</LinearLayout>