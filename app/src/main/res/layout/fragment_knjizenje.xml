<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    android:padding="12dp"
    tools:context=".fragments.KnjizenjeFragment">

    <!-- Article Name Header - Compact -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:padding="12dp"
        android:background="@drawable/bg_card_primary">

        <TextView
            android:id="@+id/article_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="16sp"
            android:fontFamily="@font/nunito_semibold"
            android:textColor="@color/content_primary"
            android:text="@string/request_for_article_scan"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Article Info Section - Horizontal Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card_primary"
        android:padding="12dp"
        android:orientation="horizontal">

        <!-- Info Items in Row -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Rack Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:padding="8dp"
                android:background="@drawable/bg_card_secondary">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:text="@string/rack_label"
                    android:textSize="12sp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/article_rack"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:textColor="@color/content_primary"
                    android:fontFamily="@font/nunito_semibold"
                    android:textAlignment="textEnd"
                    android:textSize="12sp"
                    android:maxLines="1" />

            </LinearLayout>

            <!-- Warehouse Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:padding="8dp"
                android:background="@drawable/bg_card_secondary">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:text="@string/warehouse_label"
                    android:textSize="12sp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/article_warehouse"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:textColor="@color/content_primary"
                    android:fontFamily="@font/nunito_semibold"
                    android:textAlignment="textEnd"
                    android:textSize="12sp"
                    android:maxLines="1" />

            </LinearLayout>

            <!-- Article Minimum Info -->
            <LinearLayout
                android:id="@+id/articleMinimumLl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:background="@drawable/bg_card_secondary">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:text="@string/article_minimum"
                    android:textSize="12sp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/articleMinimumTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:textColor="@color/content_primary"
                    android:fontFamily="@font/nunito_semibold"
                    android:textAlignment="textEnd"
                    android:textSize="12sp"
                    android:maxLines="1" />

            </LinearLayout>

        </LinearLayout>

        <!-- Gmail Button - Smaller -->
        <ImageButton
            android:id="@+id/sendGmail"
            style="@style/Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:layout_gravity="center_vertical"
            android:visibility="gone"
            android:contentDescription="@string/send"
            android:src="@mipmap/mail"
            app:tint="@color/content_inverse" />

    </LinearLayout>

    <!-- Stock Display Section - Compact -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card_primary"
        android:padding="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:textAllCaps="true"
            android:gravity="center"
            android:textSize="18sp"
            android:fontFamily="@font/nunito_semibold"
            android:textColor="@color/content_primary"
            android:text="@string/stock_label"
            android:maxLines="1" />

        <TextView
            android:id="@+id/article_stock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:padding="12dp"
            android:fontFamily="@font/nunito_semibold"
            android:text="0"
            style="@style/primaryButton"
            android:maxLines="1" />

    </LinearLayout>

    <!-- Compact Data Section - Fixed Height -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card_primary"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/allDataSv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="top" />

    </ScrollView>

    <!-- Stock Control Section - Compact -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card_primary"
        android:padding="12dp">

        <Button
            android:id="@+id/minusBtn"
            style="@style/Button.Destructive"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:textSize="18sp"
            android:text="-"
            android:minHeight="44dp" />

        <EditText
            android:id="@+id/stockChangeValue"
            style="@style/Input.Base"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:textSize="16sp"
            android:layout_marginBottom="0dp"
            android:text="1"
            android:inputType="number"
            android:gravity="center"
            android:minHeight="44dp"
            android:maxLines="1" />

        <Button
            android:id="@+id/plusBtn"
            style="@style/Button.Success"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="18sp"
            android:text="+"
            android:minHeight="44dp" />

    </LinearLayout>

    <!-- Input and Action Section - Compact -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card_primary"
        android:padding="12dp">

        <EditText
            android:id="@+id/idOfArticleEt"
            style="@style/Input.Base"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:hint="@string/enter_id"
            android:inputType="number"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:maxLines="1"
            android:layout_marginBottom="0dp"/>

        <ImageButton
            android:id="@+id/getArticelDataByIdBtn"
            style="@style/Button.Icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/photo_button"
            android:src="?attr/homeAsUpIndicator"
            android:rotation="180"
            android:layout_gravity="center_vertical"
            app:tint="@color/content_inverse" />

        <ImageButton
            android:id="@+id/scanQRBtn"
            style="@style/Button.Icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/scan_qr_code"
            android:src="@mipmap/qr_code_scanner"
            app:tint="@color/content_inverse"
            android:layout_gravity="center_vertical"/>

    </LinearLayout>

    <!-- Cancel Button - Compact -->
    <Button
        android:id="@+id/cancelBtn"
        style="@style/Button.Destructive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel"
        android:minHeight="44dp" />

</LinearLayout>