<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    android:padding="16dp"
    tools:context=".fragments.KnjizenjeFragment">

    <!-- Article Name Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:padding="16dp"
        android:background="@drawable/bg_card_primary">

        <TextView
            android:id="@+id/article_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="24sp"
            android:fontFamily="@font/nunito_semibold"
            android:textColor="@color/content_primary"
            android:text="@string/request_for_article_scan"
            android:maxLines="3"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Article Info Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card_primary"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Rack Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:padding="12dp"
                android:background="@drawable/bg_card_secondary">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:text="@string/rack_label"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/article_rack"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:textColor="@color/content_primary"
                    android:fontFamily="@font/nunito_semibold"
                    android:textAlignment="textEnd"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Warehouse Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:padding="12dp"
                android:background="@drawable/bg_card_secondary">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:text="@string/warehouse_label"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/article_warehouse"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:textColor="@color/content_primary"
                    android:fontFamily="@font/nunito_semibold"
                    android:textAlignment="textEnd"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Article Minimum Info -->
            <LinearLayout
                android:id="@+id/articleMinimumLl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:background="@drawable/bg_card_secondary">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:text="@string/article_minimum"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/articleMinimumTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:textColor="@color/content_primary"
                    android:fontFamily="@font/nunito_semibold"
                    android:textAlignment="textEnd"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

        </LinearLayout>

        <!-- Gmail Button -->
        <ImageButton
            android:id="@+id/sendGmail"
            style="@style/Button.Icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_gravity="center_vertical"
            android:visibility="gone"
            android:contentDescription="@string/send"
            android:src="@mipmap/mail"
            app:tint="@color/content_inverse" />

    </LinearLayout>

    <!-- Stock Display Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card_primary"
        android:padding="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:textAllCaps="true"
            android:gravity="center"
            android:textSize="24sp"
            android:fontFamily="@font/nunito_semibold"
            android:textColor="@color/content_primary"
            android:text="@string/stock_label"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/article_stock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:padding="16dp"
            android:fontFamily="@font/nunito_semibold"
            android:text="0"
            style="@style/primaryButton"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Scrollable Data Section (ONLY THIS SCROLLS) TODO: to se sploh ne prkaze -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_primary"
        android:padding="16dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/allDataSv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

    </LinearLayout>

    <!-- Stock Control Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card_primary"
        android:padding="16dp">

        <Button
            android:id="@+id/minusBtn"
            style="@style/Button.Destructive"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textSize="24sp"
            android:text="-"
            android:minHeight="56dp" />

        <EditText
            android:id="@+id/stockChangeValue"
            style="@style/Input.Base"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:textSize="24sp"
            android:layout_marginBottom="0dp"
            android:text="1"
            android:inputType="number"
            android:gravity="center"
            android:maxLines="1"
            />

        <Button
            android:id="@+id/plusBtn"
            style="@style/Button.Success"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="24sp"
            android:text="+"
            android:minHeight="56dp" />

    </LinearLayout>

    <!-- Input and Action Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card_primary"
        android:padding="16dp">

        <EditText
            android:id="@+id/idOfArticleEt"
            style="@style/Input.Base"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:hint="@string/enter_id"
            android:inputType="number"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="0dp"/>

        <ImageButton
            android:id="@+id/getArticelDataByIdBtn"
            style="@style/Button.Icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/photo_button"
            android:src="?attr/homeAsUpIndicator"
            android:rotation="180"
            android:layout_gravity="center_vertical"
            app:tint="@color/content_inverse" />

        <ImageButton
            android:id="@+id/scanQRBtn"
            style="@style/Button.Icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/scan_qr_code"
            android:src="@mipmap/qr_code_scanner"
            app:tint="@color/content_inverse"
            android:layout_gravity="center_vertical"/>

    </LinearLayout>

    <!-- Cancel Button -->
    <Button
        android:id="@+id/cancelBtn"
        style="@style/Button.Destructive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel" />

</LinearLayout>