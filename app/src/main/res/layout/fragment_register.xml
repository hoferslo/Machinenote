<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".fragments.RegisterFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_large">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Uporabnik in vloga"
                    android:textSize="@dimen/text_size_large"
                    android:fontFamily="@font/nunito_semibold"
                    android:textColor="@color/content_primary" />

                <ImageButton
                    android:id="@+id/helpButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/baseline_help_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Pomoč"
                    android:tint="@color/action_primary"/>
            </LinearLayout>

            <!-- User Mode -->
            <LinearLayout
                android:id="@+id/userSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Spinner
                    android:id="@+id/userSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:padding="@dimen/icon_button_padding"
                    android:layout_marginBottom="@dimen/input_margin_bottom"
                    style="@style/Button.Secondary"/>

                <Spinner
                    android:id="@+id/roleSpinner"
                    android:layout_width="match_parent"
                    android:padding="@dimen/icon_button_padding"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:layout_marginBottom="@dimen/spacing_xl"
                    style="@style/Button.Secondary"/>
            </LinearLayout>

            <!-- Role Mode -->
            <LinearLayout
                android:id="@+id/roleSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/addARole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ime vloge"
                    android:background="@drawable/bg_input"
                    android:padding="@dimen/input_padding"
                    android:drawableStart="@mipmap/settings"
                    android:drawablePadding="@dimen/spacing_large"
                    android:layout_marginBottom="@dimen/spacing_xl" />
            </LinearLayout>

            <!-- Permissions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dovoljenja"
                android:textSize="@dimen/text_size_large"
                android:fontFamily="@font/nunito_semibold"
                android:textColor="@color/content_primary"
                android:layout_marginBottom="@dimen/spacing_large" />

            <!-- Compact Chips -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="@dimen/spacing_medium"
                app:chipSpacingHorizontal="@dimen/spacing_medium"
                app:chipSpacingVertical="@dimen/spacing_xs">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipKnjizenje"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Knjiženje"
                    android:checkable="true"
                    style="@style/ChipTheme" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipZastoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zastoji"
                    android:checkable="true"
                    style="@style/ChipTheme" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRezervniDeli"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rezervni deli"
                    android:checkable="true"
                    style="@style/ChipTheme" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPreventivniPregledi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preventivni pregledi"
                    android:checkable="true"
                    style="@style/ChipTheme" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipImenik"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Imenik"
                    android:checkable="true"
                    style="@style/ChipTheme" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipNaloge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Naloge"
                    android:checkable="true"
                    style="@style/ChipTheme" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDodajanjeNalog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dodajanje nalog"
                    android:checkable="true"
                    style="@style/ChipTheme" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRemonti"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remonti"
                    android:checkable="true"
                    style="@style/ChipTheme" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOrodja"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Orodja"
                    android:checkable="true"
                    style="@style/ChipTheme" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Register"
                    android:checkable="true"
                    style="@style/ChipTheme" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipNarocila"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Naročila"
                    android:checkable="true"
                    style="@style/ChipTheme" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDodajanjeNarocil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dodajanje naročil"
                    android:checkable="true"
                    style="@style/ChipTheme" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipUpravljanjeNarocil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upravljanje naročil"
                    android:checkable="true"
                    style="@style/ChipTheme" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipKemikalije"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kemikalije"
                    android:checkable="true"
                    style="@style/ChipTheme" />

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>
    </ScrollView>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_xl">

        <Button
            android:id="@+id/cancelBtn"
            style="@style/Button.Destructive"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_medium"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/registerButton"
            style="@style/Button.Success"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:text="@string/send" />
    </LinearLayout>

    <!-- Tab Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/action_primary">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_primary" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/toggleGroup"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUserMode"
                style="@style/Button.MaterialTab"
                android:backgroundTint="@color/action_primary"
                android:textColor="@color/action_secondary"
                app:iconTint="@color/action_secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Uporabnik"
                app:icon="@drawable/person_add" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRoleMode"
                style="@style/Button.MaterialTab"
                android:backgroundTint="@color/action_primary"
                android:textColor="@color/action_secondary"
                app:iconTint="@color/action_secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vloga"
                app:icon="@drawable/badge" />


        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>

</LinearLayout>