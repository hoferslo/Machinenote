<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:focusable="true"
    android:clickable="true"
    tools:context=".fragments.RegisterFragment">

    <!-- Main Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:background="@drawable/background_main_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Mode Selection Toggle -->


                <!-- User Registration Section -->
                <LinearLayout
                    android:id="@+id/userSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"
                    android:padding="16dp"
                    android:background="@drawable/background_rounded_card">

                    <EditText
                        android:id="@+id/editTextUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:padding="20dp"
                        android:gravity="left"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/username"
                        android:fontFamily="@font/nunito_semibold"
                        android:background="@drawable/input_field_background"
                        android:drawableStart="@mipmap/person"
                        android:drawablePadding="12dp" />

                    <EditText
                        android:id="@+id/editTextPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:padding="20dp"
                        android:gravity="left"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/password"
                        android:inputType="textPassword"
                        android:fontFamily="@font/nunito_semibold"
                        android:background="@drawable/input_field_background"
                        android:drawableStart="@mipmap/lock"
                        android:drawablePadding="12dp" />

                    <Spinner
                        android:id="@+id/roleSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp"
                        android:background="@drawable/section_background" />

                </LinearLayout>

                <!-- Role Creation Section -->
                <LinearLayout
                    android:id="@+id/roleSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"
                    android:padding="16dp"
                    android:background="@drawable/background_rounded_card"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/addARole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:padding="20dp"
                        android:gravity="left"
                        android:hint="@string/role_name"
                        android:fontFamily="@font/nunito_semibold"
                        android:background="@drawable/input_field_background"
                        android:drawableStart="@mipmap/settings"
                        android:drawablePadding="12dp" />

                </LinearLayout>

                <!-- Permissions Section -->
                <LinearLayout
                    android:id="@+id/permissionsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"
                    android:padding="16dp"
                    android:background="@drawable/background_rounded_card">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dovoljenja"
                        android:textSize="18sp"
                        android:textColor="@color/textPrimary"
                        android:fontFamily="@font/nunito_semibold"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                    <!-- Spremenjen del - vsak checkbox v svoji vrstici -->
                    <LinearLayout
                        android:id="@+id/checkboxGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@drawable/input_field_background">

                        <!-- Prva vrstica checkboxov -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp"
                            android:padding="8dp">

                            <CheckBox
                                android:id="@+id/checkBoxKnjizenje"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/checkboxTint"
                                android:scaleX="1.1"
                                android:scaleY="1.1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Knjiženje"
                                android:textSize="14sp"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center_vertical"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp"
                            android:padding="8dp">

                            <CheckBox
                                android:id="@+id/checkBoxZastoji"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/checkboxTint"
                                android:scaleX="1.1"
                                android:scaleY="1.1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Zastoji"
                                android:textSize="14sp"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center_vertical"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp"
                            android:padding="8dp">

                            <CheckBox
                                android:id="@+id/checkBoxRezervniDelo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/checkboxTint"
                                android:scaleX="1.1"
                                android:scaleY="1.1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rezervni deli"
                                android:textSize="14sp"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center_vertical"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp"
                            android:padding="8dp">

                            <CheckBox
                                android:id="@+id/checkBoxPreventivniPregledi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/checkboxTint"
                                android:scaleX="1.1"
                                android:scaleY="1.1" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Preventivni pregledi"
                                android:textSize="14sp"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center_vertical"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp"
                            android:padding="8dp">

                            <CheckBox
                                android:id="@+id/checkBoxImenik"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/checkboxTint"
                                android:scaleX="1.1"
                                android:scaleY="1.1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Imenik"
                                android:textSize="14sp"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center_vertical"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp"
                            android:padding="8dp">

                            <CheckBox
                                android:id="@+id/checkBoxNaloge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/checkboxTint"
                                android:scaleX="1.1"
                                android:scaleY="1.1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Naloge"
                                android:textSize="14sp"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center_vertical"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp"
                            android:padding="8dp">

                            <CheckBox
                                android:id="@+id/checkBoxDodajanjeNalog"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/checkboxTint"
                                android:scaleX="1.1"
                                android:scaleY="1.1" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Dodajanje nalog"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center_vertical"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp"
                            android:padding="8dp">

                            <CheckBox
                                android:id="@+id/checkBoxRemonti"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/checkboxTint"
                                android:scaleX="1.1"
                                android:scaleY="1.1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Remonti"
                                android:textSize="14sp"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center_vertical"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp"
                            android:padding="8dp">

                            <CheckBox
                                android:id="@+id/checkBoxOrodja"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/checkboxTint"
                                android:scaleX="1.1"
                                android:scaleY="1.1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Orodja"
                                android:textSize="14sp"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center_vertical"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp"
                            android:padding="8dp">

                            <CheckBox
                                android:id="@+id/checkBoxRegister"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/checkboxTint"
                                android:scaleX="1.1"
                                android:scaleY="1.1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Register"
                                android:textSize="14sp"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center_vertical"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bottom_actions_background">

        <LinearLayout
            android:layout_width="1dp"
            android:layout_weight="0.4"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:layout_marginEnd="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:text="@string/cancel"
                style="@style/cancelButton" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="1dp"
            android:layout_weight="0.6"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/registerButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:text="@string/register_button"
                android:fontFamily="@font/nunito_semibold"
                style="@style/confirmButton" />
        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/btnUserMode">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUserMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Uporabnik"
            android:checkable="true"
            style="@style/tabButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRoleMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Vloga"
            android:checkable="true"
            style="@style/tabButton"/>

    </com.google.android.material.button.MaterialButtonToggleGroup>

</LinearLayout>