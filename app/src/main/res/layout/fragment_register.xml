<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    tools:context=".fragments.RegisterFragment">


    <!-- Main Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:background="@drawable/bg_card_primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- User Registration Section -->
                <LinearLayout
                    android:id="@+id/userSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"
                    >

                    <EditText
                        android:id="@+id/editTextUsername"
                        style="@style/Input.Base"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/username"
                        android:drawableStart="@mipmap/person"
                        android:drawablePadding="12dp"
                        android:gravity="start|center_vertical" />

                    <EditText
                        android:id="@+id/editTextPassword"
                        style="@style/Input.Base"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/password"
                        android:inputType="textPassword"
                        android:drawableStart="@mipmap/lock"
                        android:drawablePadding="12dp"
                        android:gravity="start|center_vertical" />

                    <Spinner
                        android:id="@+id/roleSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/input_min_height"
                        android:padding="20dp"
                        style="@style/Button.Primary"
                        />

                </LinearLayout>

                <!-- Role Creation Section -->
                <LinearLayout
                    android:id="@+id/roleSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_card_secondary"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/addARole"
                        style="@style/Input.Base"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/role_name"
                        android:drawableStart="@mipmap/settings"
                        android:drawablePadding="12dp"
                        android:gravity="start|center_vertical" />

                </LinearLayout>

                <!-- Permissions Section -->
                <ScrollView
                    android:id="@+id/permissionsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"

                    android:padding="16dp"
                    android:background="@drawable/bg_card_secondary">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dovoljenja"
                        android:textSize="18sp"
                        android:textColor="@color/content_primary"
                        android:fontFamily="@font/nunito_semibold"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                    <!-- Permissions Grid -->
                    <LinearLayout
                        android:id="@+id/checkboxGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_input">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <CheckBox
                                android:id="@+id/checkBoxKnjizenje"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/checkbox_tint"
                                android:scaleX="1.1"
                                android:scaleY="1.1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Knjiženje"
                                android:textSize="14sp"
                                android:textColor="@color/content_primary"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center_vertical"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>
                        <!-- Permission: Zastoji -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            >

                            <CheckBox
                                android:id="@+id/checkBoxZastoji"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/checkbox_tint"
                                android:scaleX="1.1"
                                android:scaleY="1.1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Zastoji"
                                android:textSize="14sp"
                                android:textColor="@color/content_primary"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center_vertical"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                        <!-- Permission: Rezervni deli -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="8dp">

                            <CheckBox
                                android:id="@+id/checkBoxRezervniDelo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/checkbox_tint"
                                android:scaleX="1.1"
                                android:scaleY="1.1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rezervni deli"
                                android:textSize="14sp"
                                android:textColor="@color/content_primary"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center_vertical"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                        <!-- Permission: Preventivni pregledi -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="8dp">

                            <CheckBox
                                android:id="@+id/checkBoxPreventivniPregledi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/checkbox_tint"
                                android:scaleX="1.1"
                                android:scaleY="1.1" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Preventivni pregledi"
                                android:textSize="14sp"
                                android:textColor="@color/content_primary"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center_vertical"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                        <!-- Permission: Imenik -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="8dp">

                            <CheckBox
                                android:id="@+id/checkBoxImenik"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/checkbox_tint"
                                android:scaleX="1.1"
                                android:scaleY="1.1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Imenik"
                                android:textSize="14sp"
                                android:textColor="@color/content_primary"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center_vertical"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                        <!-- Permission: Naloge -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="8dp">

                            <CheckBox
                                android:id="@+id/checkBoxNaloge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/checkbox_tint"
                                android:scaleX="1.1"
                                android:scaleY="1.1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Naloge"
                                android:textSize="14sp"
                                android:textColor="@color/content_primary"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center_vertical"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                        <!-- Permission: Dodajanje nalog -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="8dp">

                            <CheckBox
                                android:id="@+id/checkBoxDodajanjeNalog"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/checkbox_tint"
                                android:scaleX="1.1"
                                android:scaleY="1.1" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Dodajanje nalog"
                                android:textSize="14sp"
                                android:textColor="@color/content_primary"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center_vertical"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                        <!-- Permission: Remonti -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="8dp">

                            <CheckBox
                                android:id="@+id/checkBoxRemonti"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/checkbox_tint"
                                android:scaleX="1.1"
                                android:scaleY="1.1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Remonti"
                                android:textSize="14sp"
                                android:textColor="@color/content_primary"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center_vertical"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                        <!-- Permission: Orodja -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="8dp">

                            <CheckBox
                                android:id="@+id/checkBoxOrodja"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/checkbox_tint"
                                android:scaleX="1.1"
                                android:scaleY="1.1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Orodja"
                                android:textSize="14sp"
                                android:textColor="@color/content_primary"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center_vertical"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                        <!-- Permission: Register -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="8dp">

                            <CheckBox
                                android:id="@+id/checkBoxRegister"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/checkbox_tint"
                                android:scaleX="1.1"
                                android:scaleY="1.1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Register"
                                android:textSize="14sp"
                                android:textColor="@color/content_primary"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center_vertical"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                    </LinearLayout>
                    </LinearLayout>
                </ScrollView>

            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card_primary">

        <Button
            android:id="@+id/cancelBtn"
            style="@style/Button.Destructive"
            android:layout_width="0dp"
            android:layout_weight="0.4"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/registerButton"
            style="@style/Button.Success"
            android:layout_width="0dp"
            android:layout_weight="0.6"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/register_button" />

    </LinearLayout>


    <!-- Mode Selection Toggle -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/btnUserMode">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUserMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Uporabnik"
            android:checkable="true"
            style="@style/Button.MaterialTab"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRoleMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Vloga"
            android:checkable="true"
            style="@style/Button.MaterialTab"/>

    </com.google.android.material.button.MaterialButtonToggleGroup>

</LinearLayout>