<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".fragments.RegisterFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_large">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Uporabnik in vloga"
                    android:textSize="@dimen/text_size_large"
                    android:fontFamily="@font/nunito_semibold"
                    android:textColor="@color/content_primary" />

                <ImageButton
                    android:id="@+id/helpButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/baseline_help_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Pomoč"
                    app:tint="@color/action_primary"
                    />
            </LinearLayout>

            <!-- User Mode -->
            <LinearLayout
                android:id="@+id/userSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Spinner
                    android:id="@+id/userSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:padding="@dimen/icon_button_padding"
                    android:layout_marginBottom="@dimen/input_margin_bottom"
                    style="@style/Button.Secondary"/>

                <Spinner
                    android:id="@+id/roleSpinner"
                    android:layout_width="match_parent"
                    android:padding="@dimen/icon_button_padding"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:layout_marginBottom="@dimen/spacing_xl"
                    style="@style/Button.Secondary"/>
            </LinearLayout>

            <!-- Role Mode -->
            <LinearLayout
                android:id="@+id/roleSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/addARole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ime vloge"
                    android:background="@drawable/bg_input"
                    android:padding="@dimen/input_padding"
                    android:drawableStart="@mipmap/settings"
                    android:drawablePadding="@dimen/spacing_large"
                    android:layout_marginBottom="@dimen/spacing_xl" />
            </LinearLayout>

            <!-- Permissions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dovoljenja"
                android:textSize="@dimen/text_size_large"
                android:fontFamily="@font/nunito_semibold"
                android:textColor="@color/content_primary"
                android:layout_marginBottom="@dimen/spacing_large" />

            <!-- Permissions Grid Container -->
            <LinearLayout
                android:id="@+id/permissionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_input"
                android:padding="@dimen/spacing_medium">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_small">

                    <CheckBox
                        android:id="@+id/checkKnjizenje"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Knjiženje"
                        android:textSize="14sp"
                        android:padding="8dp"
                        android:buttonTint="@color/action_primary"/>

                    <CheckBox
                        android:id="@+id/checkZastoji"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Zastoji"
                        android:textSize="14sp"
                        android:padding="8dp"
                        android:buttonTint="@color/action_primary"/>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_small">

                    <CheckBox
                        android:buttonTint="@color/action_primary"
                        android:id="@+id/checkRezervniDeli"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Rezervni deli"
                        android:textSize="14sp"
                        android:padding="8dp" />

                    <CheckBox
                        android:buttonTint="@color/action_primary"
                        android:id="@+id/checkPreventivniPregledi"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Preventivni pregledi"
                        android:textSize="14sp"
                        android:padding="8dp" />
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_small">

                    <CheckBox
                        android:buttonTint="@color/action_primary"
                        android:id="@+id/checkImenik"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Imenik"
                        android:textSize="14sp"
                        android:padding="8dp" />

                    <CheckBox
                        android:buttonTint="@color/action_primary"
                        android:id="@+id/checkNaloge"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Naloge"
                        android:textSize="14sp"
                        android:padding="8dp" />
                </LinearLayout>

                <!-- Row 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_small">

                    <CheckBox
                        android:buttonTint="@color/action_primary"
                        android:id="@+id/checkDodajanjeNalog"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Dodajanje nalog"
                        android:textSize="14sp"
                        android:padding="8dp" />

                    <CheckBox
                        android:buttonTint="@color/action_primary"
                        android:id="@+id/checkRemonti"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Remonti"
                        android:textSize="14sp"
                        android:padding="8dp" />
                </LinearLayout>

                <!-- Row 5 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_small">

                    <CheckBox
                        android:buttonTint="@color/action_primary"
                        android:id="@+id/checkOrodja"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Orodja"
                        android:textSize="14sp"
                        android:padding="8dp" />

                    <CheckBox
                        android:buttonTint="@color/action_primary"
                        android:id="@+id/checkRegister"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Register"
                        android:textSize="14sp"
                        android:padding="8dp" />
                </LinearLayout>

                <!-- Row 6 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_small">

                    <CheckBox
                        android:buttonTint="@color/action_primary"
                        android:id="@+id/checkNarocila"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Naročila"
                        android:textSize="14sp"
                        android:padding="8dp" />

                    <CheckBox
                        android:buttonTint="@color/action_primary"
                        android:id="@+id/checkDodajanjeNarocil"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Dodajanje naročil"
                        android:textSize="14sp"
                        android:padding="8dp" />
                </LinearLayout>

                <!-- Row 7 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_small">

                    <CheckBox
                        android:buttonTint="@color/action_primary"
                        android:id="@+id/checkUpravljanjeNarocil"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Upravljanje naročil"
                        android:textSize="14sp"
                        android:padding="8dp" />

                    <CheckBox
                        android:buttonTint="@color/action_primary"
                        android:id="@+id/checkKemikalije"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Kemikalije"
                        android:textSize="14sp"
                        android:padding="8dp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_xl">

        <Button
            android:id="@+id/cancelBtn"
            style="@style/Button.Destructive"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_medium"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/registerButton"
            style="@style/Button.Success"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:text="@string/send" />
    </LinearLayout>

    <!-- Tab Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/action_primary">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_primary" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/toggleGroup"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUserMode"
                style="@style/Button.MaterialTab"
                android:backgroundTint="@color/action_primary"
                android:textColor="@color/action_secondary"
                app:iconTint="@color/action_secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Uporabnik"
                app:icon="@drawable/person_add" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRoleMode"
                style="@style/Button.MaterialTab"
                android:backgroundTint="@color/action_primary"
                android:textColor="@color/action_secondary"
                app:iconTint="@color/action_secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vloga"
                app:icon="@drawable/badge" />


        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>

</LinearLayout>