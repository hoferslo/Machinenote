<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    tools:context=".fragments.SettingsFragment">

    <!-- Main Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header Section -->


                <!-- Current User Info Section -->
                <LinearLayout
                    android:id="@+id/currentUserSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_card_secondary">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Trenutne informacije"
                        android:textSize="18sp"
                        android:textColor="@color/content_primary"
                        android:fontFamily="@font/nunito_semibold"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Uporabniško ime: "
                            android:textSize="14sp"
                            android:textColor="@color/content_secondary"
                            android:fontFamily="@font/nunito" />

                        <TextView
                            android:id="@+id/textCurrentUsername"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="trenutno_ime"
                            android:textSize="14sp"
                            android:textColor="@color/content_primary"
                            android:fontFamily="@font/nunito_semibold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vloga: "
                            android:textSize="14sp"
                            android:textColor="@color/content_secondary"
                            android:fontFamily="@font/nunito" />

                        <TextView
                            android:id="@+id/textCurrentRole"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="trenutna_vloga"
                            android:textSize="14sp"
                            android:textColor="@color/content_primary"
                            android:fontFamily="@font/nunito_semibold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Change Username Section -->
                <LinearLayout
                    android:id="@+id/changeUsernameSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_card_secondary">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Spremeni uporabniško ime"
                        android:textSize="18sp"
                        android:textColor="@color/content_primary"
                        android:fontFamily="@font/nunito_semibold"
                        android:layout_marginBottom="16dp" />

                    <EditText
                        android:id="@+id/editTextNewUsername"
                        style="@style/Input.Base"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Novo uporabniško ime"
                        android:drawableStart="@mipmap/person"
                        android:drawablePadding="12dp"
                        android:gravity="start|center_vertical" />

                </LinearLayout>

                <!-- Change Password Section -->
                <LinearLayout
                    android:id="@+id/changePasswordSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_card_secondary">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Spremeni geslo"
                        android:textSize="18sp"
                        android:textColor="@color/content_primary"
                        android:fontFamily="@font/nunito_semibold"
                        android:layout_marginBottom="16dp" />

                    <EditText
                        android:id="@+id/editTextCurrentPassword"
                        style="@style/Input.Base"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Trenutno geslo"
                        android:inputType="textPassword"
                        android:drawableStart="@mipmap/lock"
                        android:drawablePadding="12dp"
                        android:gravity="start|center_vertical"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/editTextNewPassword"
                        style="@style/Input.Base"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Novo geslo"
                        android:inputType="textPassword"
                        android:drawableStart="@mipmap/lock"
                        android:drawablePadding="12dp"
                        android:gravity="start|center_vertical"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/editTextConfirmPassword"
                        style="@style/Input.Base"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Potrdi novo geslo"
                        android:inputType="textPassword"
                        android:drawableStart="@mipmap/lock"
                        android:drawablePadding="12dp"
                        android:gravity="start|center_vertical" />

                </LinearLayout>

                <!-- Additional Settings Section -->
                <LinearLayout
                    android:id="@+id/additionalSettingsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_card_secondary">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dodatne nastavitve"
                        android:textSize="18sp"
                        android:textColor="@color/content_primary"
                        android:fontFamily="@font/nunito_semibold"
                        android:layout_marginBottom="16dp" />

                    <!-- Notification Toggle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Obvestila"
                            android:textSize="16sp"
                            android:textColor="@color/content_primary"
                            android:fontFamily="@font/nunito"
                            android:gravity="center_vertical" />

                        <Switch
                            android:id="@+id/switchNotifications"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />

                    </LinearLayout>

                    <!-- Theme Toggle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Temna tema"
                            android:textSize="16sp"
                            android:textColor="@color/content_primary"
                            android:fontFamily="@font/nunito"
                            android:gravity="center_vertical" />

                        <Switch
                            android:id="@+id/switchDarkTheme"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/cancelBtn"
            style="@style/Button.Destructive"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/saveChangesBtn"
            style="@style/Button.Success"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Shrani spremembe" />

    </LinearLayout>

</LinearLayout>