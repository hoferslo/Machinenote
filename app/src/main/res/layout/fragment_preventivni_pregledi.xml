<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    tools:context=".fragments.PreventivniPreglediFragment">

    <!-- Main Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Search Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_primary"
                android:padding="16dp">

                <SearchView
                    android:id="@+id/idOfDuty"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Poišči preventivni pregled"
                    android:background="@drawable/bg_input"
                    android:iconifiedByDefault="false"
                    android:queryHint="Poišči preventivni pregled"
                    android:theme="@style/SearchViewTheme" />

            </LinearLayout>

            <!-- Main List Section with RecyclerView -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_primary"
                android:padding="16dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/scrollLv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Tab Navigation -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/switchTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabPreventivniPreglediBtn"
            style="@style/Button.MaterialTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Preventivni Pregledi" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabOpravilaBtn"
            style="@style/Button.MaterialTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Opravila" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

</LinearLayout>