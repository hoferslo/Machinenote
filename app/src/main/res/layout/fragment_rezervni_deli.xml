<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    android:background="@color/background_app"
    tools:context=".fragments.KnjizenjeFragment">

    <!-- Main Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Stock Display Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_primary"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/stock_label"
                    android:textAllCaps="true"
                    android:textSize="20sp"
                    android:textColor="@color/content_primary"
                    android:fontFamily="@font/nunito_semibold"
                    android:gravity="center_vertical" />

                <TextView
                    android:id="@+id/article_stock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100"
                    android:textSize="24sp"
                    android:textColor="@color/content_primary"
                    android:fontFamily="@font/nunito_semibold"
                    android:background="@drawable/bg_card_secondary"
                    android:padding="12dp"
                    android:minWidth="60dp"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Recent Items Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_primary"
                android:padding="16dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/scrollLv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:scrollbars="none" />

                <!-- Hidden Gmail Send Button -->
                <LinearLayout
                    android:id="@+id/sendGmail"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:gravity="center"
                    android:layout_marginStart="16dp"
                    android:visibility="gone"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                </LinearLayout>
            </LinearLayout>

            <!-- Search Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_primary"
                android:padding="16dp">

                <SearchView
                    android:id="@+id/idOfDuty"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Poišči rezervni del"
                    android:background="@drawable/bg_input"
                    android:iconifiedByDefault="false"
                    android:queryHint="Poišči rezervni del"
                    android:theme="@style/SearchViewTheme" />

            </LinearLayout>

            <!-- Main Data List Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_primary"
                android:padding="16dp">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/allDataRezervniDeli"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ListView
                            android:id="@+id/allDataRezervniDeliListView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_card_secondary"
                            android:divider="@color/border_secondary"
                            android:dividerHeight="1dp"
                            android:padding="8dp" />

                    </LinearLayout>

                </ScrollView>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Tab Navigation -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/switchTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabStoppageBtn"
            style="@style/Button.Tab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Rezervni Deli" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabSmallMaterialsBtn"
            style="@style/Button.Tab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Drobni material" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

</LinearLayout>