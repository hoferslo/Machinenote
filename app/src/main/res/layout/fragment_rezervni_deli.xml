<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    tools:context=".fragments.RezervniDeliFragment">

    <!-- Main Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Search Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_primary"
                android:padding="16dp">

                <SearchView
                    android:id="@+id/idOfDuty"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Poišči rezervni del"
                    android:background="@drawable/bg_input"
                    android:iconifiedByDefault="false"
                    android:queryHint="Poišči rezervni del"
                    android:theme="@style/SearchViewTheme" />

            </LinearLayout>

            <!-- Filter & Sort Component -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@color/surface_primary"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="20dp">

                    <!-- Main Filter/Sort Toggle Button -->
                    <Button
                        android:id="@+id/filterSortToggleBtn"
                        style="@style/Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/edit"
                        android:drawablePadding="8dp"
                        android:gravity="start|center_vertical"
                        android:text="Filter &amp; Sort"
                        android:textAllCaps="false" />

                    <!-- Expandable Filter/Sort Options Container -->
                    <LinearLayout
                        android:id="@+id/filterSortContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Filter and Sort buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginBottom="12dp">

                            <Button
                                android:id="@+id/buttonFilter"
                                style="@style/Button.Primary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:text="Filter"
                                android:textAllCaps="false"
                                android:drawableStart="@drawable/clock_00_face"
                                android:drawablePadding="8dp"
                                android:gravity="center"
                                app:cornerRadius="8dp" />

                            <Button
                                android:id="@+id/buttonSort"
                                style="@style/Button.Primary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="Sort"
                                android:textAllCaps="false"
                                android:drawableStart="@drawable/schedule_icon"
                                android:drawablePadding="8dp"
                                android:gravity="center"
                                app:cornerRadius="8dp" />

                        </LinearLayout>

                        <!-- Filter Options Container -->
                        <LinearLayout
                            android:id="@+id/filterOptionsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_card_secondary"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_marginBottom="8dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:fontFamily="@font/nunito_semibold"
                                android:text="Filter Options"
                                android:textColor="@color/content_primary"
                                android:textSize="16sp" />

                            <!-- Filter by Status -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="12dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="4dp"
                                    android:fontFamily="@font/nunito_semibold"
                                    android:text="Filter by Type"
                                    android:textColor="@color/content_secondary"
                                    android:textSize="12sp" />

                                <RadioGroup
                                    android:id="@+id/statusFilterGroup"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <RadioButton
                                        android:id="@+id/radioAll"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Vse"
                                        android:checked="true"
                                        android:buttonTint="@color/action_primary" />

                                    <RadioButton
                                        android:id="@+id/radioActive"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="16dp"
                                        android:text="Na voljo"
                                        android:buttonTint="@color/action_primary" />

                                    <RadioButton
                                        android:id="@+id/radioInactive"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="16dp"
                                        android:text="Ni na voljo"
                                        android:buttonTint="@color/action_primary" />

                                </RadioGroup>

                            </LinearLayout>

                            <!-- Apply/Clear Filter Buttons -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="end">

                                <Button
                                    android:id="@+id/clearFilterBtn"
                                    style="@style/Button.Destructive"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:text="Počisti"
                                    android:textAllCaps="false" />

                                <Button
                                    android:id="@+id/applyFilterBtn"
                                    style="@style/Button.Success"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Uporabi"
                                    android:textAllCaps="false" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Sort Options Container -->
                        <LinearLayout
                            android:id="@+id/sortOptionsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_card_secondary"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:fontFamily="@font/nunito_semibold"
                                android:text="Sort Options"
                                android:textColor="@color/content_primary"
                                android:textSize="16sp" />

                            <!-- Sort by Field -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="16dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="8dp"
                                    android:fontFamily="@font/nunito_semibold"
                                    android:text="Razvrsti po"
                                    android:textColor="@color/content_secondary"
                                    android:textSize="12sp" />

                                <RadioGroup
                                    android:id="@+id/sortFieldGroup"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <RadioButton
                                        android:id="@+id/sortByName"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Artikel"
                                        android:checked="true"
                                        android:buttonTint="@color/action_primary" />

                                    <RadioButton
                                        android:id="@+id/sortByDate"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="ID"
                                        android:buttonTint="@color/action_primary" />

                                    <RadioButton
                                        android:id="@+id/sortByStatus"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Skladišče"
                                        android:buttonTint="@color/action_primary" />

                                </RadioGroup>

                            </LinearLayout>

                            <!-- Sort Order -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="16dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="8dp"
                                    android:fontFamily="@font/nunito_semibold"
                                    android:text="Vrstni red"
                                    android:textColor="@color/content_secondary"
                                    android:textSize="12sp" />

                                <RadioGroup
                                    android:id="@+id/sortOrderGroup"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <RadioButton
                                        android:id="@+id/sortAscending"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Naraščujoče (A-Z)"
                                        android:checked="true"
                                        android:buttonTint="@color/action_primary" />

                                    <RadioButton
                                        android:id="@+id/sortDescending"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="24dp"
                                        android:text="Padajoče (Z-A)"
                                        android:buttonTint="@color/action_primary" />

                                </RadioGroup>

                            </LinearLayout>

                            <!-- Apply Sort Button -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="end">

                                <Button
                                    android:id="@+id/applySortBtn"
                                    style="@style/Button.Success"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Uporabi razvrščanje"
                                    android:textAllCaps="false" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Main List Section with RecyclerView -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_primary"
                android:padding="16dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/scrollLv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_primary" />

        <!-- Tab Navigation -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/switchTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabRezervniDeliBtn"
                style="@style/Button.MaterialTab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rezervni Deli" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabSmallMaterialsBtn"
                style="@style/Button.MaterialTab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Drobni material" />

        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>
</LinearLayout>