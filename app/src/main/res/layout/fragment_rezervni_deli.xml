<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    tools:context=".fragments.RezervniDeliFragment">

    <!-- Main Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Search Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight="1"
                    android:paddingRight="8dp">
                    <SearchView
                        android:id="@+id/idOfDuty"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="Poišči rezervni del"
                        android:background="@drawable/bg_input"
                        android:iconifiedByDefault="false"
                        android:queryHint="Poišči rezervni del"
                        android:theme="@style/SearchViewTheme" />
                </LinearLayout>
                    <Button
                        android:id="@+id/filterSortToggleBtn"
                        style="@style/Button.Secondary"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:drawableEnd="@drawable/ic_filter"
                        android:drawablePadding="8dp"
                        android:gravity="start|center_vertical"
                        android:textAllCaps="false" />

            </LinearLayout>

            <!-- Filter & Sort Component -->

            <!-- Main List Section with RecyclerView -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_primary"
                android:padding="16dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/scrollLv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>



    <!-- Tab Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/action_primary"
       >

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_primary" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:checkedButton="@id/tabEntryBtn"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabRezervniDeliBtn"
                style="@style/Button.MaterialTab"
                android:backgroundTint="@color/action_primary"
                android:textColor="@color/action_secondary"
                app:iconTint="@color/action_secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tag_rezervni_deli"
                app:icon="@drawable/home_repair" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabSmallMaterialsBtn"
                style="@style/Button.MaterialTab"
                android:backgroundTint="@color/action_primary"
                android:textColor="@color/action_secondary"
                app:iconTint="@color/action_secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tag_drobni_materiali"
                app:icon="@drawable/screw" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>
</LinearLayout>