<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_primary"
    android:padding="16dp"
    android:gravity="center">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Izberi čas in datum"
            android:textColor="@color/content_primary"
            android:textSize="16sp"
            android:fontFamily="@font/nunito_semibold"
            android:layout_marginBottom="6dp" />

        <View
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:background="@color/action_primary" />

    </LinearLayout>

    <!-- Toggle Button Group for Time/Date Selection -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card_secondary"
        android:padding="6dp"
        android:backgroundTint="@color/action_primary">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_group_datetime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@+id/btn_set_time"
            android:backgroundTint="@color/action_primary">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_set_time"
                style="@style/Button.MaterialTab"
                android:backgroundTint="@color/action_primary"
                android:textColor="@color/action_secondary"
                android:textSize="18sp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Čas" />

            <com.google.android.material.button.MaterialButton
                android:backgroundTint="@color/action_primary"
                android:textColor="@color/action_secondary"
                android:textSize="18sp"
                android:id="@+id/btn_set_date"
                style="@style/Button.MaterialTab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Datum" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>

    <!-- Picker Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card_secondary"
        android:padding="12dp"

        >

        <ViewSwitcher
            android:id="@+id/view_switcher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center_vertical">

                <!-- Time labels -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ura"
                        android:textColor="@color/content_primary"
                        android:textSize="18sp"
                        android:fontFamily="@font/nunito_semibold"
                        android:gravity="center"
                        android:layout_marginLeft="32dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Minuta"
                        android:textColor="@color/content_primary"
                        android:textSize="18sp"
                        android:fontFamily="@font/nunito_semibold"
                        android:layout_marginRight="32dp"
                        android:gravity="center" />

                </LinearLayout>

                <TimePicker
                    android:id="@+id/time_picker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:timePickerMode="spinner"
                    android:theme="@style/CustomTimePickerTheme"
                    android:paddingTop="8dp"

                    android:paddingBottom="8dp" />

            </LinearLayout>

            <DatePicker
                android:id="@+id/date_picker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:theme="@style/CustomDatePickerTheme" />

        </ViewSwitcher>

    </FrameLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_card_secondary"
        android:padding="12dp">

        <Button
            android:id="@+id/btn_cancel"
            style="@style/Button.Destructive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.4"
            android:layout_marginEnd="8dp"
            android:text="Prekliči" />

        <Button
            android:id="@+id/btn_set"
            style="@style/Button.Success"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:layout_marginStart="8dp"
            android:text="Nastavi" />

    </LinearLayout>

</LinearLayout>