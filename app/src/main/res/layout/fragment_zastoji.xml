<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="false"
    android:orientation="vertical"
    tools:context=".fragments.ZastojiFragment">

    <!-- Main Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Data Entry Screen -->
        <ScrollView
            android:id="@+id/entryLl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Required Items Section -->
                <LinearLayout
                    android:id="@+id/requiredItemsLl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card_primary"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/nunito_semibold"
                        android:text="@string/potrebni_podatki"
                        android:textColor="@color/content_primary"
                        android:textSize="16sp" />

                    <ListView
                        android:id="@+id/requiredItemsLv"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:scrollbars="none" />

                </LinearLayout>

                <!-- Basic Information Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card_primary"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Sifrant Button -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/nunito_semibold"
                        android:text="@string/sifrant"
                        android:textColor="@color/content_secondary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/sifrantBtn"
                        style="@style/Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:drawableLeft="@drawable/assignment_icon"
                        android:drawablePadding="8dp"
                        android:gravity="start|center_vertical"
                        android:text="@string/izberi_sifrant" />

                    <!-- Worker Name -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/nunito_semibold"
                        android:text="@string/ime_delavca"
                        android:textColor="@color/content_secondary"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/ime_delavca"
                        style="@style/Input.Base"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="start|center_vertical"
                        android:hint="@string/vnesite_ime_delavca"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName" />

                    <!-- Reason for Stoppage -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/nunito_semibold"
                        android:text="@string/razlog_zastoja"
                        android:textColor="@color/content_secondary"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/razlog_zaustavitve_stroja"
                        style="@style/Input.Base"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="start|center_vertical"
                        android:hint="@string/vnesite_razlog"
                        android:importantForAutofill="no"
                        android:inputType="text" />

                    <!-- Notes -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/nunito_semibold"
                        android:text="@string/dodatne_opombe"
                        android:textColor="@color/content_secondary"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/opomba"
                        style="@style/Input.Base"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:hint="@string/dodatne_informacije"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine"
                        android:minHeight="80dp"
                        android:scrollbars="vertical" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:fontFamily="@font/nunito_semibold"
                                android:text="@string/linija_stroja"
                                android:textColor="@color/content_secondary"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/idOfLineBtn"
                                style="@style/Button.Secondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawablePadding="8dp"
                                android:gravity="start|center_vertical"
                                android:text="@string/izberi_linijo" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:fontFamily="@font/nunito"
                                android:gravity="center"
                                android:text="@string/skeniraj_qr"
                                android:textColor="@color/content_secondary"
                                android:textSize="12sp" />

                            <ImageButton
                                android:id="@+id/scanBtn"
                                style="@style/Button.Icon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/scan_qr_code"
                                android:src="@mipmap/qr_code_scanner" />

                        </LinearLayout>
                    </LinearLayout>
                    <!-- Options and Media Section -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Duty Checkbox Section -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_secondary"
                            android:gravity="start|center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <CheckBox
                                android:id="@+id/dezurstvoCheckBox"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/action_primary"
                                android:padding="0dp"
                                android:scaleX="1"
                                android:scaleY="1" />

                            <TextView
                                android:id="@+id/dezurstvoTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:fontFamily="@font/nunito_semibold"
                                android:text="@string/dezurstvo"
                                android:textColor="@color/content_primary"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <!-- Camera Button -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:fontFamily="@font/nunito"
                                android:gravity="center"
                                android:text="@string/dodaj_sliko"
                                android:textColor="@color/content_secondary"
                                android:textSize="12sp" />

                            <ImageButton
                                android:id="@+id/cameraBtn"
                                style="@style/Button.Icon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/photo_button"
                                android:src="@mipmap/photo_camera" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Time Section -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="@font/nunito_semibold"
                        android:text="@string/cas_zastoja"
                        android:textColor="@color/content_primary"
                        android:textSize="16sp" />

                    <!-- Time Clocks Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <!-- Start Time Clock -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_secondary"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginBottom="8dp"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center"
                                android:text="@string/zacetek_zastoja"
                                android:textColor="@color/content_secondary"
                                android:textSize="12sp" />

                            <com.leondzn.simpleanalogclock.SimpleAnalogClock
                                android:id="@+id/analogClockBefore"
                                android:layout_width="wrap_content"
                                android:layout_height="100dp"
                                android:layout_gravity="center_horizontal"
                                app:faceTint="@color/border_primary"
                                app:hourTint="@color/action_primary"
                                app:minuteTint="@color/action_primary"
                                app:secondTint="@color/action_primary" />

                            <TextView
                                android:id="@+id/textBeforeTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center"
                                android:hint="@string/start_time"
                                android:textColor="@color/content_primary"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <!-- End Time Clock -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_secondary"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginBottom="8dp"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center"
                                android:text="@string/konec_zastoja"
                                android:textColor="@color/content_secondary"
                                android:textSize="12sp" />

                            <com.leondzn.simpleanalogclock.SimpleAnalogClock
                                android:id="@+id/analogClockAfter"
                                android:layout_width="wrap_content"
                                android:layout_height="100dp"
                                android:layout_gravity="center_horizontal"
                                app:faceTint="@color/border_primary"
                                app:hourTint="@color/action_primary"
                                app:minuteTint="@color/action_primary"
                                app:secondTint="@color/action_primary" />

                            <TextView
                                android:id="@+id/textAfterTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center"
                                android:hint="@string/end_time"
                                android:textColor="@color/content_primary"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Single Images Container that will be used by both tabs -->
                <LinearLayout
                    android:id="@+id/imagesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_primary"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>

        <!-- Images Screen -->
        <LinearLayout
            android:id="@+id/imagesLl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background_app"
            android:orientation="vertical"
            android:visibility="invisible">

            <!-- Images Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_primary"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/nunito_semibold"
                    android:text="@string/slike_zastoja"
                    android:textColor="@color/content_primary"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito"
                    android:text="@string/dodajte_slike_zastoja"
                    android:textColor="@color/content_secondary"
                    android:textSize="14sp" />

            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="20dp"
                android:scrollbars="none">

                <!-- This will reference the same container -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_primary"
                        android:elevation="1dp"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- This will show the same images as the main container -->
                        <TextView
                            android:id="@+id/imagesPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Images will appear here"
                            android:textColor="@color/content_secondary"
                            android:gravity="center"
                            android:padding="20dp" />

                    </LinearLayout>
                </ScrollView>

            </ScrollView>

            <Button
                android:id="@+id/ImagesCameraBtn"
                style="@style/Button.Success"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:contentDescription="@string/photo_button"
                android:drawableStart="@mipmap/photo_camera"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="@string/dodaj_novo_sliko" />

        </LinearLayout>

    </FrameLayout>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_primary"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/cancelBtn"
            style="@style/Button.Destructive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/preklici" />

        <Button
            android:id="@+id/sendBtn"
            style="@style/Button.Success"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/potrdi" />

    </LinearLayout>

    <!-- Tab Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/action_primary">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_primary" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:checkedButton="@id/tabEntryBtn"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabEntryBtn"
                style="@style/Button.MaterialTab"
                android:backgroundTint="@color/action_primary"
                android:textColor="@color/action_secondary"
                app:iconTint="@color/action_secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_for_inserting_data"
                app:icon="@drawable/add_box" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabPicturesBtn"
                style="@style/Button.MaterialTab"
                android:backgroundTint="@color/action_primary"
                android:textColor="@color/action_secondary"
                app:iconTint="@color/action_secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_for_pictures"
                app:icon="@mipmap/photo_camera" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabInfoBtn"
                style="@style/Button.MaterialTab"
                android:backgroundTint="@color/action_primary"
                android:textColor="@color/action_secondary"
                app:iconTint="@color/action_secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_for_info"
                android:visibility="gone" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>
</LinearLayout>