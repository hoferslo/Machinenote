<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="false"
    android:clickable="true"
    tools:context=".fragments.ZastojiFragment">

    <!-- Main Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="16dp"
        >

        <!-- Data Entry Screen -->
        <LinearLayout
            android:id="@+id/entryLl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Required Items List -->
            <LinearLayout
                android:id="@+id/requiredItemsLl"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                android:minHeight="120dp"
                android:background="@drawable/bg_card_primary"
                android:padding="16dp">

                <ListView
                    android:id="@+id/requiredItemsLv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none" />

            </LinearLayout>

            <!-- Scrollable Form Content -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                >

                <LinearLayout
                    android:id="@+id/formContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >

                    <!-- Sifrant Button -->
                    <Button
                        android:id="@+id/sifrantBtn"
                        style="@style/Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="@string/sifrant" />

                    <!-- Input Fields -->
                    <EditText
                        android:id="@+id/ime_delavca"
                        style="@style/Input.Base"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/name_of_worker"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:cursorVisible="true"
                        android:textCursorDrawable="@null"
                        android:textColor="@color/content_primary" />

                    <EditText
                        android:id="@+id/razlog_zaustavitve_stroja"
                        style="@style/Input.Base"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/reason_for_stoppage"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:cursorVisible="true"
                        android:textCursorDrawable="@null"
                        android:textColor="@color/content_primary" />

                    <EditText
                        android:id="@+id/opomba"
                        style="@style/Input.Base"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/opomba"
                        android:layout_marginBottom="16dp"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:cursorVisible="true"
                        android:textCursorDrawable="@null"
                        android:textColor="@color/content_primary" />

                    <!-- Line and QR Code Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp"
                        android:padding="0dp">

                        <Button
                            android:id="@+id/idOfLineBtn"
                            style="@style/Button.Primary"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:text="@string/line" />

                        <ImageButton
                            android:id="@+id/scanBtn"
                            style="@style/Button.Icon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:contentDescription="@string/scan_qr_code"
                            android:src="@mipmap/qr_code_scanner" />

                    </LinearLayout>

                    <!-- Duty and Camera Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_card_primary"
                        android:padding="12dp">

                        <!-- Duty Checkbox Section -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="8dp">

                            <CheckBox
                                android:id="@+id/dezurstvoCheckBox"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/action_primary"
                                android:scaleX="1.2"
                                android:scaleY="1.2" />

                            <TextView
                                android:id="@+id/dezurstvoTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/dezurstvo"
                                android:textColor="@color/content_primary"
                                android:textSize="16sp"
                                android:fontFamily="@font/nunito_semibold" />

                        </LinearLayout>

                        <!-- Camera Button -->
                        <ImageButton
                            android:id="@+id/cameraBtn"
                            style="@style/Button.Icon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:contentDescription="@string/photo_button"
                            android:src="@mipmap/photo_camera" />

                    </LinearLayout>

                    <!-- Time Clocks Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:gravity="center"
                        android:background="@drawable/bg_card_primary"
                        android:padding="16dp">

                        <!-- Start Time Clock -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="16dp">

                            <com.leondzn.simpleanalogclock.SimpleAnalogClock
                                android:id="@+id/analogClockBefore"
                                android:layout_width="wrap_content"
                                android:layout_height="120dp"
                                android:layout_gravity="center_horizontal"
                                app:secondTint="@color/action_primary"
                                app:hourTint="@color/action_primary"
                                app:faceTint="@color/border_primary"
                                app:minuteTint="@color/action_primary" />

                            <TextView
                                android:id="@+id/textBeforeTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:hint="@string/start_time"
                                android:textColor="@color/content_primary"
                                android:textSize="14sp"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center" />

                        </LinearLayout>

                        <!-- End Time Clock -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.leondzn.simpleanalogclock.SimpleAnalogClock
                                android:id="@+id/analogClockAfter"
                                android:layout_width="wrap_content"
                                android:layout_height="120dp"
                                android:layout_gravity="center_horizontal"
                                app:secondTint="@color/action_primary"
                                app:hourTint="@color/action_primary"
                                app:faceTint="@color/border_primary"
                                app:minuteTint="@color/action_primary" />

                            <TextView
                                android:id="@+id/textAfterTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:hint="@string/end_time"
                                android:textColor="@color/content_primary"
                                android:textSize="14sp"
                                android:fontFamily="@font/nunito_semibold"
                                android:gravity="center" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

        </LinearLayout>

        <!-- Images Screen -->
        <LinearLayout
            android:id="@+id/imagesLl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="invisible">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:padding="16dp"
                android:background="@drawable/bg_card_primary">

                <LinearLayout
                    android:id="@+id/imagesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </ScrollView>

            <ImageButton
                android:id="@+id/ImagesCameraBtn"
                style="@style/Button.Camera.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginStart="16dp"
                android:contentDescription="@string/photo_button"
                android:src="@mipmap/photo_camera" />

        </LinearLayout>

        <!-- Info Screen -->
        <LinearLayout
            android:id="@+id/infoLl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@drawable/bg_card_primary"
            android:padding="16dp" />

    </FrameLayout>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        >

        <Button
            android:id="@+id/cancelBtn"
            style="@style/Button.Destructive"
            android:layout_width="0dp"
            android:layout_weight="0.5"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/sendBtn"
            style="@style/Button.Success"
            android:layout_width="0dp"
            android:layout_weight="0.5"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/send" />

    </LinearLayout>

    <!-- Tab Navigation -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/tabEntryBtn">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabEntryBtn"
            style="@style/Button.MaterialTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_for_inserting_data" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabPicturesBtn"
            style="@style/Button.MaterialTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_for_pictures" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabInfoBtn"
            style="@style/Button.MaterialTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone"
            android:text="@string/tab_for_info" />

    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>