<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    tools:context=".fragments.LinijeFragment">

    <!-- Main Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/padding_around_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Search Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight="1"
                    android:paddingRight="@dimen/spacing_large">
                    <SearchView
                        android:id="@+id/idOfDuty"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="Poišči linijo"
                        android:background="@drawable/bg_input"
                        android:iconifiedByDefault="false"
                        android:queryHint="Poišči linijo"
                        android:theme="@style/SearchViewTheme" />
                </LinearLayout>
                <Button
                    android:id="@+id/filterSortToggleBtn"
                    style="@style/Button.Secondary"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:drawableEnd="@drawable/ic_filter"
                    android:drawablePadding="8dp"
                    android:gravity="start|center_vertical"
                    android:textAllCaps="false" />

            </LinearLayout>

            <!-- Main List Section with RecyclerView -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_primary"
                android:padding="@dimen/padding_around_layout">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/scrollLv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical" />

            </LinearLayout>

        </LinearLayout>

        <!-- Empty State View (initially hidden) -->
        <LinearLayout
            android:id="@+id/emptyStateLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_factory"
                android:contentDescription="@string/empty_linije_list"
                android:alpha="0.5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/empty_linije_message"
                android:textColor="@color/content_secondary"
                android:textSize="16sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- Loading State View (initially hidden) -->
        <LinearLayout
            android:id="@+id/loadingStateLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/loading_linije"
                android:textColor="@color/content_secondary"
                android:textSize="16sp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>