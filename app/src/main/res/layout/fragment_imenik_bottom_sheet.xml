<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_primary"
    android:padding="@dimen/padding_around_layout">

    <!-- Company Name Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card_primary"
        android:padding="@dimen/padding_around_layout"
        android:layout_marginBottom="@dimen/margin_bottom">

        <TextView
            android:id="@+id/companyName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/ni_imena_podjetja"
            android:textSize="24sp"
            android:textColor="@color/content_primary"
            android:fontFamily="@font/nunito_semibold" />

    </LinearLayout>

    <!-- Contact Person Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="@dimen/margin_bottom"
        android:background="@drawable/bg_card_secondary"
        android:padding="@dimen/padding_around_layout">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:text="@string/kontaktna_oseba"
            android:textSize="16sp"
            android:textColor="@color/content_secondary"
            android:fontFamily="@font/nunito_semibold"
            android:drawableStart="@mipmap/person"
            android:drawablePadding="8dp"
            android:layout_marginBottom="@dimen/margin_bottom" />

        <TextView
            android:id="@+id/contactPerson"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/ni_kontaktne_osebe"
            android:textSize="18sp"
            android:textColor="@color/content_primary"
            android:fontFamily="@font/nunito_semibold" />

    </LinearLayout>

    <!-- Email Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="@dimen/margin_bottom"
        android:background="@drawable/bg_card_secondary"
        android:padding="@dimen/padding_around_layout">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:text="@string/e_posta"
            android:textSize="16sp"
            android:textColor="@color/content_secondary"
            android:fontFamily="@font/nunito_semibold"
            android:drawableStart="@mipmap/mail"
            android:drawablePadding="8dp"
            android:layout_marginBottom="@dimen/margin_bottom" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/email"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:text="@string/ni_e_mail_naslova"
                android:textSize="18sp"
                android:textColor="@color/content_primary"
                android:fontFamily="@font/nunito_semibold"
                android:layout_marginEnd="@dimen/margin_bottom" />

            <ImageButton
                android:id="@+id/buttonEmail"
                style="@style/Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@mipmap/mail"
                android:contentDescription="@string/e_posta"
                app:tint="@color/content_inverse" />

        </LinearLayout>

    </LinearLayout>

    <!-- Phone Contacts Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_secondary"
        android:padding="@dimen/padding_around_layout">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:text="@string/telefonski_kontakti"
            android:textSize="16sp"
            android:textColor="@color/content_secondary"
            android:fontFamily="@font/nunito_semibold"
            android:drawableStart="@mipmap/phone_iphone"
            android:drawablePadding="8dp"
            android:layout_marginBottom="@dimen/margin_bottom" />

        <!-- Phone Number -->
        <LinearLayout
            android:id="@+id/phoneNumberLl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/margin_bottom">

            <TextView
                android:id="@+id/phoneNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:text="@string/ni_telefonske_tevilke"
                android:textSize="18sp"
                android:textColor="@color/content_primary"
                android:fontFamily="@font/nunito_semibold"
                android:layout_marginEnd="@dimen/margin_bottom" />

            <ImageButton
                android:id="@+id/buttonPhoneNumber"
                style="@style/Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@mipmap/call"
                android:contentDescription="@string/telefonski_kontakti"
                app:tint="@color/content_inverse" />

        </LinearLayout>

        <!-- GSM Number -->
        <LinearLayout
            android:id="@+id/gsmLl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/GSM"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:text="@string/ni_gsm_tevilke"
                android:textSize="18sp"
                android:textColor="@color/content_primary"
                android:fontFamily="@font/nunito_semibold"
                android:layout_marginEnd="@dimen/margin_bottom" />

            <ImageButton
                android:id="@+id/buttonGSM"
                style="@style/Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@mipmap/call"
                android:contentDescription="@string/telefonski_kontakti"
                app:tint="@color/content_inverse" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>