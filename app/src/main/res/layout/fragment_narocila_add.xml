<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    tools:context=".fragments.NarocilaFragment">

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            >

            <LinearLayout
                android:id="@+id/formContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >

                <!-- Sifrant Button -->
                <Spinner
                    android:id="@+id/lokacijaSpinner"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/lokacija" />

                <!-- Input Fields -->
                <EditText
                    android:id="@+id/ime_delavca"
                    style="@style/Input.Base"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/narocnik"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:cursorVisible="true"
                    android:textCursorDrawable="@null"
                    android:textColor="@color/content_primary" />

                <EditText
                    android:id="@+id/razlog_zaustavitve_stroja"
                    style="@style/Input.Base"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/naziv_artikla"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:cursorVisible="true"
                    android:textCursorDrawable="@null"
                    android:textColor="@color/content_primary" />

                <EditText
                    android:id="@+id/opomba"
                    style="@style/Input.Base"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/tehnicni_podatki"
                    android:layout_marginBottom="16dp"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:cursorVisible="true"
                    android:textCursorDrawable="@null"
                    android:textColor="@color/content_primary" />

                <!-- Line and QR Code Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp"
                    android:padding="0dp">

                    <Button
                        android:id="@+id/idOfLineBtn"
                        style="@style/Button.Primary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text="@string/line" />

                    <ImageButton
                        android:id="@+id/scanBtn"
                        style="@style/Button.Icon"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="@string/scan_qr_code"
                        android:src="@mipmap/qr_code_scanner" />

                </LinearLayout>

                <!-- Duty and Camera Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card_primary"
                    android:padding="12dp">

                    <!-- Duty Checkbox Section -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="8dp">

                        <CheckBox
                            android:id="@+id/dezurstvoCheckBox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/action_primary"
                            android:scaleX="1.2"
                            android:scaleY="1.2" />

                        <TextView
                            android:id="@+id/dezurstvoTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/dezurstvo"
                            android:textColor="@color/content_primary"
                            android:textSize="16sp"
                            android:fontFamily="@font/nunito_semibold" />

                    </LinearLayout>

                    <!-- Camera Button -->
                    <ImageButton
                        android:id="@+id/cameraBtn"
                        style="@style/Button.Icon"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="@string/photo_button"
                        android:src="@mipmap/photo_camera" />

                </LinearLayout>

                <!-- Time Clocks Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:gravity="center"
                    android:background="@drawable/bg_card_primary"
                    android:padding="16dp">

                    <!-- Start Time Clock -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="16dp">

                        <com.leondzn.simpleanalogclock.SimpleAnalogClock
                            android:id="@+id/analogClockBefore"
                            android:layout_width="wrap_content"
                            android:layout_height="120dp"
                            android:layout_gravity="center_horizontal"
                            app:secondTint="@color/action_primary"
                            app:hourTint="@color/action_primary"
                            app:faceTint="@color/border_primary"
                            app:minuteTint="@color/action_primary" />

                        <TextView
                            android:id="@+id/textBeforeTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:hint="@string/start_time"
                            android:textColor="@color/content_primary"
                            android:textSize="14sp"
                            android:fontFamily="@font/nunito_semibold"
                            android:gravity="center" />

                    </LinearLayout>

                    <!-- End Time Clock -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.leondzn.simpleanalogclock.SimpleAnalogClock
                            android:id="@+id/analogClockAfter"
                            android:layout_width="wrap_content"
                            android:layout_height="120dp"
                            android:layout_gravity="center_horizontal"
                            app:secondTint="@color/action_primary"
                            app:hourTint="@color/action_primary"
                            app:faceTint="@color/border_primary"
                            app:minuteTint="@color/action_primary" />

                        <TextView
                            android:id="@+id/textAfterTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:hint="@string/end_time"
                            android:textColor="@color/content_primary"
                            android:textSize="14sp"
                            android:fontFamily="@font/nunito_semibold"
                            android:gravity="center" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!-- Tab Navigation -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_primary" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/vnos_naloge_Ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@id/tabNalogeBtn">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabNalogeBtn"
                style="@style/Button.MaterialTab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/narocila" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabVnosNalogeBtn"
                style="@style/Button.MaterialTab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/vnos_narocila"
                app:icon="@drawable/add_box"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>
</LinearLayout>