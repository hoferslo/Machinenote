<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    tools:context=".fragments.NarocilaFragment">

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            >

            <LinearLayout
                android:id="@+id/formContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >

                <!-- Sifrant Button -->
                <Spinner
                    android:id="@+id/lokacijaSpinner"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/lokacija" />

                <!-- Input Fields -->
                <EditText
                    android:id="@+id/nameOfShipper"
                    style="@style/Input.Base"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/narocnik"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:cursorVisible="true"
                    android:textCursorDrawable="@null"
                    android:textColor="@color/content_primary" />

                <EditText
                    android:id="@+id/articleName"
                    style="@style/Input.Base"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/naziv_artikla"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:cursorVisible="true"
                    android:textCursorDrawable="@null"
                    android:textColor="@color/content_primary" />

                <EditText
                    android:id="@+id/technicalInfo"
                    style="@style/Input.Base"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/tehnicni_podatki"
                    android:layout_marginBottom="16dp"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:cursorVisible="true"
                    android:textCursorDrawable="@null"
                    android:textColor="@color/content_primary" />

                <!-- Line and QR Code Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp"
                    android:padding="0dp">

                    <Button
                        android:id="@+id/rokDobave"
                        style="@style/Button.Primary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text="@string/rok_dobave" />

                </LinearLayout>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/amountOfArticle"
                        style="@style/Input.Base"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/kolicina"
                        android:layout_marginBottom="16dp"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:cursorVisible="true"
                        android:textCursorDrawable="@null"
                        android:textColor="@color/content_primary"
                        android:layout_weight="1"
                        />

                    <Spinner
                        android:id="@+id/enotaSpinner"
                        style="@style/Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Enota"
                        android:layout_weight="3"
                        />
                </LinearLayout>


                <!-- Slika Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_primary"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/slika"
                        android:textSize="12sp"
                        android:textColor="@color/content_secondary"
                        android:fontFamily="@font/nunito_semibold"
                        android:layout_marginBottom="8dp" />

                    <!-- Image Preview -->
                    <ImageView
                        android:id="@+id/imagePreview"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_card_secondary"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="@string/predogled_slike" />

                    <!-- Image Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageButton
                            android:id="@+id/dodajSlikoBtn"
                            style="@style/Button.Icon"
                            android:layout_width="56dp"
                            android:layout_weight="1"
                            android:layout_height="56dp"
                            android:contentDescription="@string/photo_button"
                            android:src="@mipmap/photo_camera" />

                        <Button
                            android:id="@+id/odstranislikoBtn"
                            style="@style/Button.Destructive"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="@string/odstrani_sliko"
                            android:drawableStart="@drawable/description"
                            android:drawablePadding="8dp"
                            android:visibility="gone" />

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Tab Navigation -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_primary" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/vnos_naloge_Ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@id/tabNalogeBtn">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabNalogeBtn"
                style="@style/Button.MaterialTab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/narocila" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabVnosNalogeBtn"
                style="@style/Button.MaterialTab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/vnos_narocila"
                app:icon="@drawable/add_box"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>
</LinearLayout>