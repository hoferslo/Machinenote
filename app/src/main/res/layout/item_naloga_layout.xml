<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_primary">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/naloga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/content_primary"
            android:fontFamily="@font/nunito_semibold"
            android:text="Naslov naloge"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_card_secondary" />

        <TextView
            android:id="@+id/vzdrzevalec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/content_secondary"
            android:fontFamily="@font/nunito_semibold"
            android:text="vzdrzevalec"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/rokZaIzvedbo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/content_secondary"
            android:fontFamily="@font/nunito_semibold"
            android:text="rokZaIzvedbo"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/komentar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/content_secondary"
            android:fontFamily="@font/nunito_semibold"
            android:text="komentar"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/izvedeno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/content_secondary"
            android:fontFamily="@font/nunito_semibold"
            android:text="izvedeno" />
    </LinearLayout>

    <Button
        android:id="@+id/buttonAction"
        style="@style/Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lahk bi biu za editat"
        android:visibility="gone"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="16dp" />
</LinearLayout>