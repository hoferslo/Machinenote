<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    tools:context=".fragments.NalogeFragment">

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Search Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_primary"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@mipmap/search"
                android:layout_marginEnd="12dp"
                android:contentDescription="" />

            <SearchView
                android:id="@+id/idOfDuty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:queryHint="@string/isci_nalogo"
                android:iconifiedByDefault="false"
                android:queryBackground="@android:color/transparent"
                android:background="@android:color/transparent"
                android:searchIcon="@null"
                android:submitBackground="@android:color/transparent"
                android:theme="@style/SearchViewTheme"/>

        </LinearLayout>

        <!-- Content List Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card_primary"
            android:layout_marginBottom="16dp">

            <!-- List Header (Optional) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/available_tasks"
                android:textColor="@color/content_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/nunito_semibold"
                android:padding="16dp"
                android:paddingBottom="8dp" />

            <!-- RecyclerView Container -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/scrollLv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:padding="8dp"
                android:paddingTop="0dp"
                android:clipToPadding="false"
                />

        </LinearLayout>

        <!-- Action Button -->
        <Button
            android:id="@+id/cancelBtn"
            style="@style/Button.Destructive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />

    </LinearLayout>

    <!-- Tab Navigation -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/vnos_naloge_Ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/tabNalogeBtn">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabNalogeBtn"
            style="@style/Button.MaterialTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/naloge" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabVnosNalogeBtn"
            style="@style/Button.MaterialTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/vnos_naloge" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

</LinearLayout>