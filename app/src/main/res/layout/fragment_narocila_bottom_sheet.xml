<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:nestedScrollingEnabled="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_primary"
        android:padding="16dp">

        <!-- Handle bar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_secondary"
            android:backgroundTint="@color/content_secondary" />

        <!-- Header z naslovom -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_primary"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Potrditev dostave"
                android:textSize="24sp"
                android:textColor="@color/content_primary"
                android:fontFamily="@font/nunito_semibold" />

        </LinearLayout>

        <!-- Narocilo informacije -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_secondary"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/narocilo"
                android:textSize="16sp"
                android:textColor="@color/content_secondary"
                android:fontFamily="@font/nunito_semibold"
                android:drawableStart="@drawable/assignment_icon"
                android:drawablePadding="8dp"
                android:layout_marginBottom="8dp"
                android:drawableTint="?attr/colorControlNormal" />

            <TextView
                android:id="@+id/narociloNazivTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Naziv naročila"
                android:textColor="@color/content_primary"
                android:textSize="18sp"
                android:fontFamily="@font/nunito_semibold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/narocnik"
                        android:textSize="14sp"
                        android:textColor="@color/content_secondary"
                        android:fontFamily="@font/nunito_semibold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/narociloNarocnikTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ime naročnika"
                        android:textSize="18sp"
                        android:textColor="@color/content_primary"
                        android:fontFamily="@font/nunito_semibold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lokacija"
                        android:textSize="14sp"
                        android:textColor="@color/content_secondary"
                        android:fontFamily="@font/nunito_semibold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/narociloLokacijaTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lokacija"
                        android:textSize="18sp"
                        android:textColor="@color/content_primary"
                        android:fontFamily="@font/nunito_semibold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Datum in čas dostave -->
        <LinearLayout
            android:id="@+id/datumCasLl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_secondary"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/datum_cas_dostave"
                android:textSize="16sp"
                android:textColor="@color/content_secondary"
                android:fontFamily="@font/nunito_semibold"
                android:drawableStart="@drawable/calendar"
                android:drawablePadding="8dp"
                android:layout_marginBottom="8dp"
                android:drawableTint="?attr/colorControlNormal" />

            <Button
                style="@style/Button.Primary"
                android:id="@+id/DatumBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Izberi datum in čas"
                android:fontFamily="@font/nunito_semibold" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/prekliclBtn"
                style="@style/Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/cancel" />

            <Button
                android:id="@+id/potrdiDostavo"
                style="@style/Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/potrdi_dostavo"
                />

        </LinearLayout>

    </LinearLayout>

</ScrollView>