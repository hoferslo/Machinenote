<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    android:background="@color/background_app"
    tools:context=".fragments.NarocilaManageFragment">

    <!-- Main Content Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/formContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Status Management Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_primary"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_narocila"
                    android:textSize="16sp"
                    android:textColor="@color/content_primary"
                    android:fontFamily="@font/nunito_semibold"
                    android:layout_marginBottom="16dp" />

                <!-- Status Spinner -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/trenutni_status"
                    android:textSize="12sp"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/statusSpinner"
                    style="@style/Button.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp" />

                <!-- Predvideni datum dostave -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/predvidena_dostava"
                    android:textSize="12sp"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:layout_marginBottom="4dp" />

                <Button
                    android:id="@+id/predvidenaDostavaBtn"
                    style="@style/Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nastavi_predvideno_dostavo"
                    android:drawableLeft="@drawable/calendar"
                    android:drawablePadding="8dp"
                    android:gravity="start|center_vertical"
                    android:layout_marginBottom="16dp" />

                <!-- Opombe za admin -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/opombe_admin"
                    android:textSize="12sp"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/adminOpombe"
                    style="@style/Input.Base"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:hint="@string/interno_sporocilo_opombe"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:gravity="top|start"
                    android:scrollbars="vertical" />

            </LinearLayout>

            <!-- Basic Information Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_primary"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.3"
                        android:text="@string/osnovni_podatki"
                        android:textSize="16sp"
                        android:textColor="@color/content_primary"
                        android:fontFamily="@font/nunito_semibold"

                        />

                    <Button
                        android:id="@+id/editBasicInfoBtn"
                        style="@style/Button.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:icon="@drawable/edit"
                        app:iconSize="20dp"
                        app:iconTint="@color/content_secondary"

                        />

                </LinearLayout>

                <!-- Location Spinner -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lokacija"
                    android:textSize="12sp"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/lokacijaSpinner"
                    style="@style/Button.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:enabled="false" />

                <!-- Naročnik Input -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/narocnik"
                    android:textSize="12sp"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/nameOfShipper"
                    style="@style/Input.Base"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/vnesite_ime_narocnika"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName"
                    android:gravity="start|center_vertical"
                    android:layout_marginBottom="16dp"
                    android:enabled="false" />

                <!-- Original Delivery Date -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/zahtevani_rok_dobave"
                    android:textSize="12sp"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:layout_marginBottom="4dp" />

                <Button
                    android:id="@+id/rokDobave"
                    style="@style/Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/izberite_datum"
                    android:drawableLeft="@drawable/calendar"
                    android:drawablePadding="8dp"
                    android:gravity="start|center_vertical"
                    android:enabled="false" />

            </LinearLayout>

            <!-- Article Information Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_primary"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/podatki_o_artiklu"
                        android:textSize="16sp"
                        android:textColor="@color/content_primary"
                        android:fontFamily="@font/nunito_semibold" />

                    <Button
                        android:id="@+id/editArticleBtn"
                        style="@style/Button.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:icon="@drawable/edit"
                        app:iconSize="20dp"
                        app:iconTint="@color/content_secondary"
                        />

                </LinearLayout>

                <!-- Article Name -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/naziv_artikla"
                    android:textSize="12sp"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/articleName"
                    style="@style/Input.Base"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/vnesite_naziv"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:gravity="start|center_vertical"
                    android:layout_marginBottom="16dp"
                    android:enabled="false" />

                <!-- Quantity and Unit Row -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kolicina_in_enota"
                    android:textSize="12sp"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/amountOfArticle"
                        style="@style/Input.Base"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="0dp"
                        android:hint="@string/kolicina"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:gravity="center"
                        android:enabled="false" />

                    <Spinner
                        android:id="@+id/enotaSpinner"
                        style="@style/Button.Icon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/enota"
                        android:enabled="false" />

                </LinearLayout>

                <!-- Technical Info -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tehnicni_podatki"
                    android:textSize="12sp"
                    android:textColor="@color/content_secondary"
                    android:fontFamily="@font/nunito_semibold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/technicalInfo"
                    style="@style/Input.Base"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:hint="@string/dodatni_tehnicni_podatki"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:gravity="top|start"
                    android:scrollbars="vertical"
                    android:enabled="false" />

            </LinearLayout>

            <!-- Image Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_primary"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/slika_artikla"
                        android:textSize="16sp"
                        android:textColor="@color/content_primary"
                        android:fontFamily="@font/nunito_semibold" />

                    <Button
                        android:id="@+id/editImageBtn"
                        style="@style/Button.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:icon="@drawable/edit"
                        app:iconSize="20dp"
                        app:iconTint="@color/content_secondary"
                        />
                </LinearLayout>

                <!-- Image Preview Container -->
                <LinearLayout
                    android:id="@+id/imagePreviewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_secondary"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/imagePreview"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_card_secondary"
                        android:contentDescription="@string/predogled_slike" />

                </LinearLayout>

                <!-- No Image Placeholder -->
                <LinearLayout
                    android:id="@+id/noImagePlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_secondary"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ni_slike"
                        android:textSize="14sp"
                        android:textColor="@color/content_tertiary"
                        android:fontFamily="@font/nunito"
                        android:gravity="center" />

                </LinearLayout>

                <!-- Image Action Buttons -->
                <LinearLayout
                    android:id="@+id/imageButtonsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/dodajSlikoBtn"
                        style="@style/Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="@string/dodaj_sliko"
                        android:drawableStart="@mipmap/photo_camera"
                        android:drawablePadding="8dp"
                        android:gravity="center" />

                    <Button
                        android:id="@+id/odstranislikoBtn"
                        style="@style/Button.Destructive"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/odstrani_sliko"
                        android:gravity="center"
                        android:visibility="gone" />

                </LinearLayout>
            </LinearLayout>

            <!-- Timestamps Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_primary"
                android:padding="20dp"
                android:layout_marginBottom="20dp"
                android:elevation="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/informacije_o_narocilu"
                    android:textSize="16sp"
                    android:textColor="@color/content_primary"
                    android:fontFamily="@font/nunito_semibold"
                    android:layout_marginBottom="16dp" />

                <!-- Naročilo ustvarjeno -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ustvarjeno"
                        android:textSize="12sp"
                        android:textColor="@color/content_secondary"
                        android:fontFamily="@font/nunito_semibold" />

                    <TextView
                        android:id="@+id/createdTimestamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15.01.2025, 14:30"
                        android:textSize="12sp"
                        android:textColor="@color/content_primary"
                        android:fontFamily="@font/nunito" />

                </LinearLayout>

                <!-- Zadnja sprememba -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/zadnja_sprememba"
                        android:textSize="12sp"
                        android:textColor="@color/content_secondary"
                        android:fontFamily="@font/nunito_semibold" />

                    <TextView
                        android:id="@+id/updatedTimestamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16.01.2025, 09:15"
                        android:textSize="12sp"
                        android:textColor="@color/content_primary"
                        android:fontFamily="@font/nunito" />

                </LinearLayout>

                <!-- ID naročila -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/id_narocila"
                        android:textSize="12sp"
                        android:textColor="@color/content_secondary"
                        android:fontFamily="@font/nunito_semibold" />

                    <TextView
                        android:id="@+id/orderIdText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#NAR-2025-001"
                        android:textSize="12sp"
                        android:textColor="@color/content_primary"
                        android:fontFamily="@font/nunito" />

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_primary"
        android:elevation="8dp">

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_primary" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <Button
                android:id="@+id/nazajBtn"
                style="@style/Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/nazaj"
                android:gravity="center" />

            <Button
                android:id="@+id/shraniSpremembeBtn"
                style="@style/Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/shrani_spremembe"
                android:gravity="center" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>