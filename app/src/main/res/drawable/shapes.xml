<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ============= ALL DRAWABLES IN ONE FILE ============= -->
    <!-- File: res/drawable/shapes.xml -->

    <!-- 1. CARDS & SURFACES -->
    <shape name="bg_card_primary" android:shape="rectangle">
        <solid android:color="@color/surface_primary" />
        <corners android:radius="16dp" />
        <stroke android:width="1dp" android:color="@color/border_primary" />
    </shape>

    <shape name="bg_card_secondary" android:shape="rectangle">
        <solid android:color="@color/surface_secondary" />
        <corners android:radius="20dp" />
        <stroke android:width="1dp" android:color="@color/border_secondary" />
    </shape>

    <!-- 2. SECTIONS & BACKGROUNDS -->
    <shape name="bg_section" android:shape="rectangle">
        <solid android:color="@color/background_section" />
        <corners android:radius="16dp" />
    </shape>

    <shape name="bg_app_rounded" android:shape="rectangle">
        <solid android:color="@color/background_app" />
        <corners android:radius="12dp" />
    </shape>

    <!-- 3. INPUT FIELDS -->
    <shape name="bg_input" android:shape="rectangle">
        <solid android:color="@color/surface_tertiary" />
        <corners android:radius="20dp" />
        <stroke android:width="1dp" android:color="@color/border_primary" />
    </shape>

    <!-- 4. IMAGES -->
    <shape name="bg_image" android:shape="rectangle">
        <solid android:color="@color/surface_primary" />
        <corners android:radius="16dp" />
        <stroke android:width="1dp" android:color="@color/border_primary" />
    </shape>

    <!-- 5. BUTTONS WITH RIPPLE EFFECTS -->
    <ripple name="bg_button_primary" android:color="?attr/colorControlHighlight">
        <item android:state_pressed="true">
            <shape android:shape="rectangle">
                <solid android:color="@color/action_primary_pressed" />
                <corners android:radius="20dp" />
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="@color/action_primary" />
                <corners android:radius="20dp" />
            </shape>
        </item>
    </ripple>

    <ripple name="bg_button_secondary" android:color="?attr/colorControlHighlight">
        <item android:state_pressed="true">
            <shape android:shape="rectangle">
                <solid android:color="@color/action_secondary_pressed" />
                <corners android:radius="20dp" />
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="@color/action_secondary" />
                <corners android:radius="20dp" />
            </shape>
        </item>
    </ripple>

    <ripple name="bg_button_success" android:color="?attr/colorControlHighlight">
        <item android:state_pressed="true">
            <shape android:shape="rectangle">
                <solid android:color="@color/action_success_pressed" />
                <corners android:radius="20dp" />
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="@color/action_success" />
                <corners android:radius="20dp" />
            </shape>
        </item>
    </ripple>

    <ripple name="bg_button_destructive" android:color="?attr/colorControlHighlight">
        <item android:state_pressed="true">
            <shape android:shape="rectangle">
                <solid android:color="@color/action_destructive_pressed" />
                <corners android:radius="20dp" />
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="@color/action_destructive" />
                <corners android:radius="20dp" />
            </shape>
        </item>
    </ripple>

    <!-- 6. TOGGLE BUTTONS -->
    <selector name="bg_toggle_button">
        <item android:state_checked="true" android:color="@color/state_selected"/>
        <item android:color="@color/surface_secondary" />
    </selector>

    <selector name="text_toggle_button">
        <item android:state_checked="true" android:color="@color/content_inverse"/>
        <item android:color="@color/content_secondary"/>
    </selector>

    <!-- 7. INTERACTIVE CARDS -->
    <selector name="bg_card_interactive">
        <item android:state_pressed="true">
            <shape android:shape="rectangle">
                <solid android:color="@color/state_pressed" />
                <corners android:radius="16dp" />
                <stroke android:width="1dp" android:color="@color/border_accent" />
            </shape>
        </item>
        <item android:state_selected="true">
            <shape android:shape="rectangle">
                <solid android:color="@color/surface_primary" />
                <corners android:radius="16dp" />
                <stroke android:width="2dp" android:color="@color/border_accent" />
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="@color/surface_primary" />
                <corners android:radius="16dp" />
                <stroke android:width="1dp" android:color="@color/border_primary" />
            </shape>
        </item>
    </selector>

    <!-- 8. OUTLINE BUTTONS -->
    <selector name="bg_button_outline">
        <item android:state_pressed="true">
            <shape android:shape="rectangle">
                <solid android:color="@color/state_pressed" />
                <corners android:radius="12dp" />
                <stroke android:width="2dp" android:color="@color/action_destructive" />
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="@color/transparent" />
                <corners android:radius="12dp" />
                <stroke android:width="2dp" android:color="@color/action_destructive" />
            </shape>
        </item>
    </selector>

</resources>